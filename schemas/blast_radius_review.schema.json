{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ams:ams:blast-radius-review:v0",
  "title": "AMSBlastRadiusReview",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "blast_radius_review_id",
    "label",
    "source_root",
    "package_name",
    "subject_kind",
    "subject_id",
    "change_intent",
    "paths",
    "scoped_paths",
    "required",
    "graph_snapshot_ref",
    "query_refs",
    "impact_summary",
    "decision",
    "reason_codes",
    "raw_source_stored",
    "created_at",
    "blast_radius_review_sha256"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "ams.ams.blast_radius_review.v0" },
    "blast_radius_review_id": { "type": "string", "minLength": 1 },
    "label": { "type": "string", "minLength": 1 },
    "source_root": { "type": "string", "minLength": 1 },
    "package_name": { "type": "string", "minLength": 1 },
    "subject_kind": { "type": "string", "minLength": 1 },
    "subject_id": { "type": "string", "minLength": 1 },
    "change_intent": { "type": "string", "minLength": 1 },
    "paths": { "type": "array", "items": { "type": "string" } },
    "scoped_paths": { "type": "array", "items": { "type": "string" } },
    "required": { "type": "boolean" },
    "graph_snapshot_ref": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": [
        "codebase_spider_graph_snapshot_id",
        "codebase_spider_graph_snapshot_sha256",
        "source_snapshot_sha256",
        "status"
      ],
      "properties": {
        "codebase_spider_graph_snapshot_id": { "type": "string", "minLength": 1 },
        "codebase_spider_graph_snapshot_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "source_snapshot_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "status": { "type": "string", "enum": ["allow", "defer", "deny"] }
      }
    },
    "query_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "query_kind",
          "codebase_graph_query_receipt_id",
          "codebase_graph_query_receipt_sha256",
          "status",
          "graph_fresh"
        ],
        "properties": {
          "query_kind": { "type": "string", "enum": ["impact_slice", "related_tests", "stale_graph_check"] },
          "codebase_graph_query_receipt_id": { "type": "string", "minLength": 1 },
          "codebase_graph_query_receipt_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "status": { "type": "string", "enum": ["allow", "defer", "deny"] },
          "graph_fresh": { "type": "boolean" }
        }
      }
    },
    "impact_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_paths",
        "impact_paths",
        "impact_count",
        "related_tests",
        "related_test_count",
        "stale_paths",
        "rejected_paths",
        "max_impact_paths",
        "impact_over_limit",
        "raw_source_stored"
      ],
      "properties": {
        "input_paths": { "type": "array", "items": { "type": "string" } },
        "impact_paths": { "type": "array", "items": { "type": "string" } },
        "impact_count": { "type": "integer", "minimum": 0 },
        "related_tests": { "type": "array", "items": { "type": "string" } },
        "related_test_count": { "type": "integer", "minimum": 0 },
        "stale_paths": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "reason"],
            "properties": {
              "path": { "type": "string" },
              "reason": { "type": "string" }
            }
          }
        },
        "rejected_paths": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "reason"],
            "properties": {
              "path": { "type": "string" },
              "reason": { "type": "string" }
            }
          }
        },
        "max_impact_paths": { "type": "integer", "minimum": 0 },
        "impact_over_limit": { "type": "boolean" },
        "raw_source_stored": { "type": "boolean", "const": false }
      }
    },
    "decision": { "type": "string", "enum": ["allow", "defer", "deny"] },
    "reason_codes": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "raw_source_stored": { "type": "boolean", "const": false },
    "created_at": { "type": "string", "minLength": 1 },
    "blast_radius_review_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
