{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ams:ams:discord-canary-send-plan:v0",
  "title": "AMSDiscordCanarySendPlan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "discord_canary_send_plan_id",
    "mode",
    "outbox_id",
    "outbox_sha256",
    "admission_review_id",
    "admission_review_sha256",
    "surface_promise_id",
    "surface_promise_sha256",
    "discord_source_packet_id",
    "discord_source_packet_sha256",
    "task_run_id",
    "session_id",
    "target",
    "channel_id",
    "endpoint",
    "method",
    "payload_sha256",
    "outbox_nonce",
    "nonce_semantics",
    "exactly_once_claimed",
    "canary_mode",
    "network_call_allowed",
    "send_performed",
    "gateway_started",
    "token_stored",
    "readback_required",
    "expected_readback",
    "operator_review_ref",
    "required_gates",
    "status",
    "reason_codes",
    "created_at",
    "canary_send_plan_sha256"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "ams.ams.discord_canary_send_plan.v0" },
    "discord_canary_send_plan_id": { "type": "string", "minLength": 1 },
    "mode": { "type": "string", "const": "canary" },
    "outbox_id": { "type": "string", "minLength": 1 },
    "outbox_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "admission_review_id": { "type": "string", "minLength": 1 },
    "admission_review_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "surface_promise_id": { "type": ["string", "null"] },
    "surface_promise_sha256": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" },
    "discord_source_packet_id": { "type": ["string", "null"] },
    "discord_source_packet_sha256": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" },
    "task_run_id": { "type": "string", "minLength": 1 },
    "session_id": { "type": "string", "minLength": 1 },
    "target": { "type": "string", "const": "discord" },
    "channel_id": { "type": "string", "minLength": 1 },
    "endpoint": { "type": "string", "minLength": 1 },
    "method": { "type": "string", "const": "POST" },
    "payload_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "outbox_nonce": { "type": "string", "minLength": 1 },
    "nonce_semantics": { "type": "string", "const": "provider_validation_only" },
    "exactly_once_claimed": { "type": "boolean", "const": false },
    "canary_mode": { "type": "boolean", "const": true },
    "network_call_allowed": { "type": "boolean", "const": false },
    "send_performed": { "type": "boolean", "const": false },
    "gateway_started": { "type": "boolean", "const": false },
    "token_stored": { "type": "boolean", "const": false },
    "readback_required": { "type": "boolean", "const": true },
    "expected_readback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "status",
        "required_provider_message_id",
        "required_readback_ref_prefix",
        "nonce_must_match",
        "nonce_is_provider_validation_only"
      ],
      "properties": {
        "provider": { "type": "string", "const": "discord" },
        "status": { "type": "string", "const": "readback_verified" },
        "required_provider_message_id": { "type": "boolean", "const": true },
        "required_readback_ref_prefix": { "type": ["string", "null"] },
        "nonce_must_match": { "type": "boolean", "const": true },
        "nonce_is_provider_validation_only": { "type": "boolean", "const": true }
      }
    },
    "operator_review_ref": { "type": ["string", "null"] },
    "required_gates": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "status": { "type": "string", "enum": ["ready_for_operator_approval", "blocked"] },
    "reason_codes": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "canary_send_plan_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
