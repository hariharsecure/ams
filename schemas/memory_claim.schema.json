{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ams:ams-codex:memory-claim:v0",
  "title": "AMSCodexMemoryClaim",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "memory_claim_id",
    "label",
    "domain",
    "subject",
    "predicate",
    "scope",
    "valid_from",
    "valid_until",
    "value_sha256",
    "value_ref",
    "value_summary",
    "value_summary_sha256",
    "raw_value_stored",
    "source_ref",
    "source_kind",
    "trust_class",
    "retrieval_is_authority",
    "base_semantic_key",
    "semantic_key",
    "candidate_claim_sha256",
    "status",
    "created_at",
    "memory_claim_sha256"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "ams.ams_codex.memory_claim.v0" },
    "memory_claim_id": { "type": "string", "minLength": 1 },
    "label": { "type": "string", "minLength": 1 },
    "domain": { "type": "string", "minLength": 1 },
    "subject": { "type": "string", "minLength": 1 },
    "predicate": { "type": "string", "minLength": 1 },
    "scope": { "type": "string", "minLength": 1 },
    "valid_from": { "type": ["string", "null"] },
    "valid_until": { "type": ["string", "null"] },
    "value_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "value_ref": { "type": ["string", "null"] },
    "value_summary": { "type": "string" },
    "value_summary_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "raw_value_stored": { "type": "boolean", "const": false },
    "source_ref": { "type": "string", "minLength": 1 },
    "source_kind": { "type": "string", "minLength": 1 },
    "trust_class": {
      "type": "string",
      "enum": [
        "user_asserted",
        "operator_asserted",
        "system_record",
        "generated_surface",
        "provider_evidence",
        "retrieved_evidence"
      ]
    },
    "retrieval_is_authority": { "type": "boolean", "const": false },
    "base_semantic_key": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "semantic_key": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "candidate_claim_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "status": { "type": "string", "const": "active" },
    "created_at": { "type": "string", "minLength": 1 },
    "memory_claim_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
