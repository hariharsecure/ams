{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ams:ams:shadow-approval-packet:v0",
  "title": "AMSShadowApprovalPacket",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "shadow_approval_packet_id",
    "shadow_launch_plan_id",
    "shadow_launch_plan_sha256",
    "shadow_runner_transaction_id",
    "shadow_runner_transaction_sha256",
    "runner_dry_run_parity_id",
    "runner_dry_run_parity_sha256",
    "store_backup_drill_id",
    "store_backup_drill_sha256",
    "operator_readback",
    "required_readback_phrases",
    "required_gates",
    "approval_granted",
    "live_start_allowed",
    "process_start_allowed",
    "network_egress_allowed",
    "start_actions",
    "status",
    "reason_codes",
    "created_at",
    "approval_packet_sha256"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "ams.ams.shadow_approval_packet.v0" },
    "shadow_approval_packet_id": { "type": "string", "minLength": 1 },
    "shadow_launch_plan_id": { "type": "string", "minLength": 1 },
    "shadow_launch_plan_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "shadow_runner_transaction_id": { "type": "string", "minLength": 1 },
    "shadow_runner_transaction_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "runner_dry_run_parity_id": { "type": "string", "minLength": 1 },
    "runner_dry_run_parity_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "store_backup_drill_id": { "type": "string", "minLength": 1 },
    "store_backup_drill_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "operator_readback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested_by",
        "ref",
        "summary",
        "summary_sha256",
        "required_phrases_present",
        "missing_required_phrases",
        "created_at"
      ],
      "properties": {
        "requested_by": { "type": "string", "minLength": 1 },
        "ref": { "type": ["string", "null"] },
        "summary": { "type": "string" },
        "summary_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "required_phrases_present": { "type": "boolean" },
        "missing_required_phrases": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "created_at": { "type": "string", "format": "date-time" }
      }
    },
    "required_readback_phrases": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "uniqueItems": true
    },
    "required_gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shadow_launch_plan_ready",
        "shadow_launch_plan_no_egress",
        "shadow_launch_plan_inert",
        "runner_transaction_ready",
        "runner_transaction_inert",
        "runner_parity_ready",
        "runner_parity_inert",
        "backup_drill_passed",
        "all_refs_same_shadow_launch_plan",
        "operator_readback_present",
        "operator_readback_required_phrases",
        "approval_granted_false",
        "live_start_allowed_false"
      ],
      "properties": {
        "shadow_launch_plan_ready": { "type": "boolean" },
        "shadow_launch_plan_no_egress": { "type": "boolean" },
        "shadow_launch_plan_inert": { "type": "boolean" },
        "runner_transaction_ready": { "type": "boolean" },
        "runner_transaction_inert": { "type": "boolean" },
        "runner_parity_ready": { "type": "boolean" },
        "runner_parity_inert": { "type": "boolean" },
        "backup_drill_passed": { "type": "boolean" },
        "all_refs_same_shadow_launch_plan": { "type": "boolean" },
        "operator_readback_present": { "type": "boolean" },
        "operator_readback_required_phrases": { "type": "boolean" },
        "approval_granted_false": { "type": "boolean", "const": true },
        "live_start_allowed_false": { "type": "boolean", "const": true }
      }
    },
    "approval_granted": { "type": "boolean", "const": false },
    "live_start_allowed": { "type": "boolean", "const": false },
    "process_start_allowed": { "type": "boolean", "const": false },
    "network_egress_allowed": { "type": "boolean", "const": false },
    "start_actions": { "type": "array", "maxItems": 0 },
    "status": { "type": "string", "enum": ["ready_for_operator_approval", "blocked"] },
    "reason_codes": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "approval_packet_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
