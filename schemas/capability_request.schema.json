{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ams:ams:capability-request:v0",
  "title": "AMSCapabilityRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "capability_request_id",
    "actor",
    "tier",
    "action",
    "paths",
    "tools",
    "egress_mode",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "ams.ams.capability_request.v0"
    },
    "capability_request_id": { "type": "string", "minLength": 1 },
    "actor": { "type": "string", "minLength": 1 },
    "tier": { "type": "string", "minLength": 1 },
    "action": { "type": "string", "minLength": 1 },
    "paths": { "type": "array", "items": { "type": "string" } },
    "tools": { "type": "array", "items": { "type": "string" } },
    "egress_mode": { "type": "string", "minLength": 1 },
    "change_request_id": { "type": ["string", "null"] },
    "admission_review_id": { "type": ["string", "null"] },
    "signed_policy_sha256": {
      "type": ["string", "null"],
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "architecture_gate_review_id": { "type": ["string", "null"] },
    "architecture_audit_id": { "type": ["string", "null"] },
    "architecture_audit_sha256": {
      "type": ["string", "null"],
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
