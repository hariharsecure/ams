{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ams:ams:discord-canary-receipt:v0",
  "title": "AMSDiscordCanaryReceipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "discord_canary_receipt_id",
    "discord_canary_send_plan_id",
    "discord_canary_send_plan_sha256",
    "outbox_id",
    "outbox_sha256",
    "outbox_receipt_id",
    "outbox_receipt_sha256",
    "observation_mode",
    "provider",
    "response_payload_sha256",
    "provider_message_id",
    "readback_ref",
    "expected_nonce",
    "observed_nonce_sha256",
    "nonce_match",
    "nonce_semantics",
    "exactly_once_claimed",
    "network_call_performed",
    "token_stored",
    "raw_content_stored",
    "required_gates",
    "status",
    "reason_codes",
    "created_at",
    "canary_receipt_sha256"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "ams.ams.discord_canary_receipt.v0" },
    "discord_canary_receipt_id": { "type": "string", "minLength": 1 },
    "discord_canary_send_plan_id": { "type": ["string", "null"] },
    "discord_canary_send_plan_sha256": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" },
    "outbox_id": { "type": ["string", "null"] },
    "outbox_sha256": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" },
    "outbox_receipt_id": { "type": ["string", "null"] },
    "outbox_receipt_sha256": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" },
    "observation_mode": { "type": "string", "enum": ["external_observed", "operator_supplied", "simulated_success"] },
    "provider": { "type": "string", "const": "discord" },
    "response_payload_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "provider_message_id": { "type": ["string", "null"] },
    "readback_ref": { "type": "string" },
    "expected_nonce": { "type": ["string", "null"] },
    "observed_nonce_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "nonce_match": { "type": "boolean" },
    "nonce_semantics": { "type": "string", "const": "provider_validation_only" },
    "exactly_once_claimed": { "type": "boolean", "const": false },
    "network_call_performed": { "type": "boolean", "const": false },
    "token_stored": { "type": "boolean", "const": false },
    "raw_content_stored": { "type": "boolean", "const": false },
    "required_gates": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "status": { "type": "string", "enum": ["recorded", "blocked"] },
    "reason_codes": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "canary_receipt_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
