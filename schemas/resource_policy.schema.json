{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ams:ams-codex:resource-policy:v0",
  "title": "AMSCodexResourcePolicy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "resource_policy_id",
    "name",
    "scope",
    "global_limits",
    "provider_profiles",
    "status_cadence",
    "created_at"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "ams.ams_codex.resource_policy.v0" },
    "resource_policy_id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["install_id", "workspace_roots", "default_egress"],
      "properties": {
        "install_id": { "type": "string", "minLength": 1 },
        "workspace_roots": { "type": "array", "items": { "type": "string" } },
        "default_egress": { "type": "string", "enum": ["deny", "ams_outbox", "allow"] }
      }
    },
    "global_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_concurrent_runs", "max_daily_input_tokens", "max_daily_output_tokens", "max_daily_usd"],
      "properties": {
        "max_concurrent_runs": { "type": "integer", "minimum": 1 },
        "max_daily_input_tokens": { "type": "integer", "minimum": 0 },
        "max_daily_output_tokens": { "type": "integer", "minimum": 0 },
        "max_daily_usd": { "type": "number", "minimum": 0 }
      }
    },
    "provider_profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "profile_id",
          "provider",
          "surface",
          "model_pattern",
          "max_concurrent_runs",
          "max_context_tokens",
          "max_input_tokens_per_run",
          "max_output_tokens_per_run",
          "max_runtime_seconds",
          "local_resources",
          "allowed_cwd_roots",
          "allowed_tools",
          "denied_tools",
          "egress_modes",
          "data_classes"
        ],
        "properties": {
          "profile_id": { "type": "string", "minLength": 1 },
          "provider": { "type": "string", "minLength": 1 },
          "surface": { "type": "string", "minLength": 1 },
          "model_pattern": { "type": "string", "minLength": 1 },
          "max_concurrent_runs": { "type": "integer", "minimum": 1 },
          "max_context_tokens": { "type": "integer", "minimum": 1 },
          "max_input_tokens_per_run": { "type": "integer", "minimum": 0 },
          "max_output_tokens_per_run": { "type": "integer", "minimum": 0 },
          "max_runtime_seconds": { "type": "integer", "minimum": 1 },
          "local_resources": {
            "type": "object",
            "additionalProperties": false,
            "required": ["cpu_cores", "memory_mb", "gpu_memory_mb"],
            "properties": {
              "cpu_cores": { "type": "integer", "minimum": 0 },
              "memory_mb": { "type": "integer", "minimum": 0 },
              "gpu_memory_mb": { "type": "integer", "minimum": 0 }
            }
          },
          "allowed_cwd_roots": { "type": "array", "items": { "type": "string" } },
          "allowed_tools": { "type": "array", "items": { "type": "string" } },
          "denied_tools": { "type": "array", "items": { "type": "string" } },
          "egress_modes": { "type": "array", "items": { "type": "string", "enum": ["none", "ams_outbox", "direct"] } },
          "data_classes": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "status_cadence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min_seconds_between_status_posts", "prefer_edit_existing_status", "max_public_status_per_hour"],
      "properties": {
        "min_seconds_between_status_posts": { "type": "integer", "minimum": 0 },
        "prefer_edit_existing_status": { "type": "boolean" },
        "max_public_status_per_hour": { "type": "integer", "minimum": 0 }
      }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "policy_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
