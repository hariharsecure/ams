{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ams:ams:semantic-hook-target-snapshot:v0",
  "title": "AMSSemanticHookTargetSnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "semantic_hook_target_snapshot_id",
    "label",
    "source_root",
    "home_root",
    "semantic_hook_approval_binding_id",
    "semantic_hook_approval_binding_sha256",
    "semantic_hook_install_plan_id",
    "semantic_hook_install_plan_sha256",
    "target_count",
    "target_snapshots",
    "rollback_drill",
    "required_gates",
    "approval_granted",
    "live_install_allowed",
    "hook_file_write_allowed",
    "hook_trust_allowed",
    "provider_hook_execution_allowed",
    "backup_write_allowed",
    "restore_allowed",
    "install_actions",
    "trust_actions",
    "start_actions",
    "live_boundaries",
    "status",
    "reason_codes",
    "created_at",
    "semantic_hook_target_snapshot_sha256"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "ams.ams.semantic_hook_target_snapshot.v0" },
    "semantic_hook_target_snapshot_id": { "type": "string", "minLength": 1 },
    "label": { "type": "string", "minLength": 1 },
    "source_root": { "type": "string", "minLength": 1 },
    "home_root": { "type": "string", "minLength": 1 },
    "semantic_hook_approval_binding_id": { "type": "string", "minLength": 1 },
    "semantic_hook_approval_binding_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "semantic_hook_install_plan_id": { "type": "string", "minLength": 1 },
    "semantic_hook_install_plan_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "target_count": { "type": "integer", "minimum": 0 },
    "target_snapshots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target",
          "declared_path",
          "resolved_path",
          "path_was_tilde",
          "exists",
          "is_file",
          "is_directory",
          "is_symlink",
          "path_under_allowed_root",
          "traversal_detected",
          "size_bytes",
          "over_hash_limit",
          "current_sha256",
          "raw_content_stored",
          "secret_stored",
          "write_performed",
          "restore_action",
          "safe_for_no_write_drill"
        ],
        "properties": {
          "target": { "type": ["string", "null"] },
          "declared_path": { "type": "string" },
          "resolved_path": { "type": "string", "minLength": 1 },
          "path_was_tilde": { "type": "boolean" },
          "exists": { "type": "boolean" },
          "is_file": { "type": "boolean" },
          "is_directory": { "type": "boolean" },
          "is_symlink": { "type": "boolean" },
          "path_under_allowed_root": { "type": "boolean" },
          "traversal_detected": { "type": "boolean" },
          "size_bytes": { "type": "integer", "minimum": 0 },
          "over_hash_limit": { "type": "boolean" },
          "current_sha256": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" },
          "raw_content_stored": { "type": "boolean", "const": false },
          "secret_stored": { "type": "boolean", "const": false },
          "write_performed": { "type": "boolean", "const": false },
          "restore_action": { "type": "string", "enum": ["restore_file_sha256", "delete_created_file"] },
          "safe_for_no_write_drill": { "type": "boolean" }
        }
      }
    },
    "rollback_drill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "target_count",
        "safe_target_count",
        "backup_file_written",
        "restore_performed",
        "raw_backup_content_stored",
        "rollback_rehearsal_passed",
        "rollback_strategy"
      ],
      "properties": {
        "mode": { "type": "string", "const": "hash_only_no_write" },
        "target_count": { "type": "integer", "minimum": 0 },
        "safe_target_count": { "type": "integer", "minimum": 0 },
        "backup_file_written": { "type": "boolean", "const": false },
        "restore_performed": { "type": "boolean", "const": false },
        "raw_backup_content_stored": { "type": "boolean", "const": false },
        "rollback_rehearsal_passed": { "type": "boolean" },
        "rollback_strategy": { "type": "string", "minLength": 1 }
      }
    },
    "required_gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approval_binding_ready",
        "approval_binding_inert",
        "install_plan_ready",
        "target_count_matches_install_plan",
        "target_paths_under_allowed_roots",
        "no_symlinks",
        "no_path_traversal",
        "no_directories",
        "within_hash_size_limit",
        "snapshots_hash_only",
        "rollback_drill_no_write",
        "rollback_rehearsal_passed",
        "approval_granted_false",
        "live_install_allowed_false"
      ],
      "properties": {
        "approval_binding_ready": { "type": "boolean" },
        "approval_binding_inert": { "type": "boolean" },
        "install_plan_ready": { "type": "boolean" },
        "target_count_matches_install_plan": { "type": "boolean" },
        "target_paths_under_allowed_roots": { "type": "boolean" },
        "no_symlinks": { "type": "boolean" },
        "no_path_traversal": { "type": "boolean" },
        "no_directories": { "type": "boolean" },
        "within_hash_size_limit": { "type": "boolean" },
        "snapshots_hash_only": { "type": "boolean" },
        "rollback_drill_no_write": { "type": "boolean" },
        "rollback_rehearsal_passed": { "type": "boolean" },
        "approval_granted_false": { "type": "boolean", "const": true },
        "live_install_allowed_false": { "type": "boolean", "const": true }
      }
    },
    "approval_granted": { "type": "boolean", "const": false },
    "live_install_allowed": { "type": "boolean", "const": false },
    "hook_file_write_allowed": { "type": "boolean", "const": false },
    "hook_trust_allowed": { "type": "boolean", "const": false },
    "provider_hook_execution_allowed": { "type": "boolean", "const": false },
    "backup_write_allowed": { "type": "boolean", "const": false },
    "restore_allowed": { "type": "boolean", "const": false },
    "install_actions": { "type": "array", "maxItems": 0 },
    "trust_actions": { "type": "array", "maxItems": 0 },
    "start_actions": { "type": "array", "maxItems": 0 },
    "live_boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hook_file_written",
        "hook_installed",
        "hook_trusted",
        "provider_hook_executed",
        "backup_file_written",
        "restore_performed",
        "discord_call_performed",
        "terminal_attach_performed",
        "terminal_capture_performed",
        "terminal_injection_performed",
        "persistent_process_started",
        "provider_call_performed",
        "network_call_performed",
        "raw_content_stored",
        "secret_stored"
      ],
      "properties": {
        "hook_file_written": { "type": "boolean", "const": false },
        "hook_installed": { "type": "boolean", "const": false },
        "hook_trusted": { "type": "boolean", "const": false },
        "provider_hook_executed": { "type": "boolean", "const": false },
        "backup_file_written": { "type": "boolean", "const": false },
        "restore_performed": { "type": "boolean", "const": false },
        "discord_call_performed": { "type": "boolean", "const": false },
        "terminal_attach_performed": { "type": "boolean", "const": false },
        "terminal_capture_performed": { "type": "boolean", "const": false },
        "terminal_injection_performed": { "type": "boolean", "const": false },
        "persistent_process_started": { "type": "boolean", "const": false },
        "provider_call_performed": { "type": "boolean", "const": false },
        "network_call_performed": { "type": "boolean", "const": false },
        "raw_content_stored": { "type": "boolean", "const": false },
        "secret_stored": { "type": "boolean", "const": false }
      }
    },
    "status": { "type": "string", "enum": ["ready_for_operator_review", "blocked"] },
    "reason_codes": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "semantic_hook_target_snapshot_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
