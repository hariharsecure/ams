{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ams:ams:capability-verdict:v0",
  "title": "AMSCapabilityVerdict",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "capability_verdict_id",
    "status",
    "policy_id",
    "policy_sha256",
    "tier",
    "action",
    "reason_codes",
    "allowed_paths",
    "deferred_paths",
    "denied_paths",
    "review_required",
    "checked_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "ams.ams.capability_verdict.v0"
    },
    "capability_verdict_id": { "type": "string", "minLength": 1 },
    "capability_request_id": { "type": ["string", "null"] },
    "status": { "type": "string", "enum": ["allow", "defer", "deny"] },
    "policy_id": { "type": "string", "minLength": 1 },
    "policy_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "tier": { "type": "string", "minLength": 1 },
    "action": { "type": "string", "minLength": 1 },
    "reason_codes": { "type": "array", "items": { "type": "string" } },
    "allowed_paths": { "type": "array", "items": { "type": "string" } },
    "deferred_paths": { "type": "array", "items": { "type": "string" } },
    "denied_paths": { "type": "array", "items": { "type": "string" } },
    "review_required": { "type": "boolean" },
    "checked_at": { "type": "string", "format": "date-time" }
  }
}
