        "source_file_delete_allowed_by_packet": { "type": "boolean", "const": false },
        "archive_create_allowed_by_packet": { "type": "boolean", "const": false },
        "generated_surface_rewrite_allowed_by_packet": { "type": "boolean", "const": false },
        "raw_patch_stored_in_ams_state": { "type": "boolean", "const": false },
        "raw_source_markdown_stored_in_ams_state": { "type": "boolean", "const": false },
        "raw_approval_stored_in_ams_state": { "type": "boolean", "const": false }
