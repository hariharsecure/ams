{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ams:ams:semantic-hook-approval-binding:v0",
  "title": "AMSSemanticHookApprovalBinding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "semantic_hook_approval_binding_id",
    "label",
    "source_root",
    "semantic_hook_install_plan_id",
    "semantic_hook_install_plan_sha256",
    "semantic_hook_run_id",
    "semantic_hook_run_sha256",
    "semantic_oracle_review_id",
    "codex_hook_config_preview_sha256",
    "claude_hook_contract_preview_sha256",
    "semantic_hook_record_set_sha256",
    "install_target_count",
    "package_manifest",
    "package_manifest_sha256",
    "package_verification",
    "package_verification_sha256",
    "package_provenance",
    "rollback_evidence",
    "no_egress_controls",
    "operator_readback",
    "required_readback_phrases",
    "required_gates",
    "approval_granted",
    "live_install_allowed",
    "hook_file_write_allowed",
    "hook_trust_allowed",
    "provider_hook_execution_allowed",
    "start_actions",
    "live_boundaries",
    "status",
    "reason_codes",
    "created_at",
    "semantic_hook_approval_binding_sha256"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "ams.ams.semantic_hook_approval_binding.v0" },
    "semantic_hook_approval_binding_id": { "type": "string", "minLength": 1 },
    "label": { "type": "string", "minLength": 1 },
    "source_root": { "type": "string", "minLength": 1 },
    "semantic_hook_install_plan_id": { "type": "string", "minLength": 1 },
    "semantic_hook_install_plan_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "semantic_hook_run_id": { "type": "string", "minLength": 1 },
    "semantic_hook_run_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "semantic_oracle_review_id": { "type": "string", "minLength": 1 },
    "codex_hook_config_preview_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "claude_hook_contract_preview_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "semantic_hook_record_set_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "install_target_count": { "type": "integer", "minimum": 0 },
    "package_manifest": { "type": "object" },
    "package_manifest_sha256": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" },
    "package_verification": { "type": "object" },
    "package_verification_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "package_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verification_result_present",
        "verification_result_sha256",
        "raw_verification_result_stored",
        "signed_package_verified",
        "verification_status",
        "verification_reason_code",
        "signature_verified",
        "signer_identity",
        "signer_fingerprint",
        "signer_fingerprint_pinned",
        "signature_namespace",
        "package_manifest_id",
        "package_manifest_sha256",
        "package_manifest_payload_sha256",
        "package_mode",
        "raw_manifest_stored",
        "raw_signature_stored",
        "manifest_required_artifacts",
        "manifest_artifact_matches",
        "manifest_declares_exact_install_plan",
        "manifest_declares_exact_hook_run",
        "manifest_declares_exact_codex_preview",
        "manifest_declares_exact_claude_preview"
      ],
      "properties": {
        "verification_result_present": { "type": "boolean" },
        "verification_result_sha256": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" },
        "raw_verification_result_stored": { "type": "boolean", "const": false },
        "signed_package_verified": { "type": "boolean" },
        "verification_status": { "type": ["string", "null"] },
        "verification_reason_code": { "type": ["string", "null"] },
        "signature_verified": { "type": "boolean" },
        "signer_identity": { "type": ["string", "null"] },
        "signer_fingerprint": { "type": ["string", "null"] },
        "signer_fingerprint_pinned": { "type": "boolean" },
        "signature_namespace": { "type": ["string", "null"] },
        "package_manifest_id": { "type": ["string", "null"] },
        "package_manifest_sha256": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" },
        "package_manifest_payload_sha256": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" },
        "package_mode": { "type": ["string", "null"] },
        "raw_manifest_stored": { "type": "boolean", "const": false },
        "raw_signature_stored": { "type": "boolean", "const": false },
        "manifest_required_artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["artifact_id", "artifact_type", "artifact_sha256"],
            "properties": {
              "artifact_id": { "type": "string", "minLength": 1 },
              "artifact_type": { "type": "string", "minLength": 1 },
              "artifact_sha256": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" }
            }
          }
        },
        "manifest_artifact_matches": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "expected_sha256",
              "actual_sha256",
              "expected_type",
              "actual_type",
              "status",
              "matched"
            ],
            "properties": {
              "expected_sha256": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" },
              "actual_sha256": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" },
              "expected_type": { "type": ["string", "null"] },
              "actual_type": { "type": ["string", "null"] },
              "status": { "type": ["string", "null"] },
              "matched": { "type": "boolean" }
            }
          }
        },
        "manifest_declares_exact_install_plan": { "type": "boolean" },
        "manifest_declares_exact_hook_run": { "type": "boolean" },
        "manifest_declares_exact_codex_preview": { "type": "boolean" },
        "manifest_declares_exact_claude_preview": { "type": "boolean" }
      }
    },
    "rollback_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rollback_proof_ref",
        "rollback_proof_sha256",
        "rollback_preflight_passed",
        "hook_files_backed_up",
        "hook_files_restored",
        "write_performed",
        "raw_rollback_material_stored"
      ],
      "properties": {
        "rollback_proof_ref": { "type": ["string", "null"] },
        "rollback_proof_sha256": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" },
        "rollback_preflight_passed": { "type": "boolean" },
        "hook_files_backed_up": { "type": "boolean", "const": false },
        "hook_files_restored": { "type": "boolean", "const": false },
        "write_performed": { "type": "boolean", "const": false },
        "raw_rollback_material_stored": { "type": "boolean", "const": false }
      }
    },
    "no_egress_controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "egress_mode",
        "discord_send_allowed",
        "terminal_attach_allowed",
        "terminal_capture_allowed",
        "terminal_injection_allowed",
        "provider_call_allowed",
        "provider_hook_execution_allowed",
        "persistent_process_allowed",
        "network_allowed"
      ],
      "properties": {
        "egress_mode": { "type": "string", "const": "none" },
        "discord_send_allowed": { "type": "boolean", "const": false },
        "terminal_attach_allowed": { "type": "boolean", "const": false },
        "terminal_capture_allowed": { "type": "boolean", "const": false },
        "terminal_injection_allowed": { "type": "boolean", "const": false },
        "provider_call_allowed": { "type": "boolean", "const": false },
        "provider_hook_execution_allowed": { "type": "boolean", "const": false },
        "persistent_process_allowed": { "type": "boolean", "const": false },
        "network_allowed": { "type": "boolean", "const": false }
      }
    },
    "operator_readback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "readback_ref",
        "readback_present",
        "readback_sha256",
        "readback_text_sha256",
        "raw_readback_stored",
        "required_phrases_present",
        "missing_required_phrases",
        "created_at"
      ],
      "properties": {
        "readback_ref": { "type": ["string", "null"] },
        "readback_present": { "type": "boolean" },
        "readback_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "readback_text_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "raw_readback_stored": { "type": "boolean", "const": false },
        "required_phrases_present": { "type": "boolean" },
        "missing_required_phrases": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "created_at": { "type": "string", "format": "date-time" }
      }
    },
    "required_readback_phrases": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "uniqueItems": true
    },
    "required_gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "install_plan_ready",
        "install_plan_inert",
        "signed_package_verified",
        "signature_verified",
        "pinned_signer_verified",
        "manifest_declares_exact_install_plan",
        "manifest_declares_exact_hook_run",
        "manifest_declares_exact_codex_preview",
        "manifest_declares_exact_claude_preview",
        "rollback_proof_present",
        "rollback_preflight_passed",
        "rollback_inert",
        "no_egress_controls_present",
        "operator_readback_present",
        "operator_readback_required_phrases",
        "approval_granted_false",
        "live_install_allowed_false"
      ],
      "properties": {
        "install_plan_ready": { "type": "boolean" },
        "install_plan_inert": { "type": "boolean" },
        "signed_package_verified": { "type": "boolean" },
        "signature_verified": { "type": "boolean" },
        "pinned_signer_verified": { "type": "boolean" },
        "manifest_declares_exact_install_plan": { "type": "boolean" },
        "manifest_declares_exact_hook_run": { "type": "boolean" },
        "manifest_declares_exact_codex_preview": { "type": "boolean" },
        "manifest_declares_exact_claude_preview": { "type": "boolean" },
        "rollback_proof_present": { "type": "boolean" },
        "rollback_preflight_passed": { "type": "boolean" },
        "rollback_inert": { "type": "boolean" },
        "no_egress_controls_present": { "type": "boolean", "const": true },
        "operator_readback_present": { "type": "boolean" },
        "operator_readback_required_phrases": { "type": "boolean" },
        "approval_granted_false": { "type": "boolean", "const": true },
        "live_install_allowed_false": { "type": "boolean", "const": true }
      }
    },
    "approval_granted": { "type": "boolean", "const": false },
    "live_install_allowed": { "type": "boolean", "const": false },
    "hook_file_write_allowed": { "type": "boolean", "const": false },
    "hook_trust_allowed": { "type": "boolean", "const": false },
    "provider_hook_execution_allowed": { "type": "boolean", "const": false },
    "start_actions": { "type": "array", "maxItems": 0 },
    "live_boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hook_file_written",
        "hook_installed",
        "hook_trusted",
        "provider_hook_executed",
        "discord_call_performed",
        "terminal_attach_performed",
        "terminal_capture_performed",
        "terminal_injection_performed",
        "persistent_process_started",
        "provider_call_performed",
        "embedding_call_performed",
        "vector_write_performed",
        "network_call_performed",
        "raw_content_stored",
        "secret_stored"
      ],
      "properties": {
        "hook_file_written": { "type": "boolean", "const": false },
        "hook_installed": { "type": "boolean", "const": false },
        "hook_trusted": { "type": "boolean", "const": false },
        "provider_hook_executed": { "type": "boolean", "const": false },
        "discord_call_performed": { "type": "boolean", "const": false },
        "terminal_attach_performed": { "type": "boolean", "const": false },
        "terminal_capture_performed": { "type": "boolean", "const": false },
        "terminal_injection_performed": { "type": "boolean", "const": false },
        "persistent_process_started": { "type": "boolean", "const": false },
        "provider_call_performed": { "type": "boolean", "const": false },
        "embedding_call_performed": { "type": "boolean", "const": false },
        "vector_write_performed": { "type": "boolean", "const": false },
        "network_call_performed": { "type": "boolean", "const": false },
        "raw_content_stored": { "type": "boolean", "const": false },
        "secret_stored": { "type": "boolean", "const": false }
      }
    },
    "status": { "type": "string", "enum": ["ready_for_operator_approval", "blocked"] },
    "reason_codes": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "semantic_hook_approval_binding_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
