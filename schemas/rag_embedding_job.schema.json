{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ams:ams:rag-embedding-job:v0",
  "title": "AMSRAGEmbeddingJob",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "rag_embedding_job_id",
    "rag_index_plan_id",
    "rag_index_plan_sha256",
    "collection",
    "embedding",
    "vector_store",
    "provider_gate",
    "downloaded_artifact_quarantine_ids",
    "planned_batches",
    "planned_vectors",
    "batch_count",
    "chunk_count",
    "idempotency_key",
    "status",
    "reason_codes",
    "created_at",
    "job_sha256"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "ams.ams.rag_embedding_job.v0" },
    "rag_embedding_job_id": { "type": "string", "minLength": 1 },
    "rag_index_plan_id": { "type": "string", "minLength": 1 },
    "rag_index_plan_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "collection": { "type": "string", "minLength": 1 },
    "embedding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "dimensions", "status"],
      "properties": {
        "provider": { "type": "string", "enum": ["none", "openai", "local"] },
        "model": { "type": ["string", "null"] },
        "dimensions": { "type": ["integer", "null"], "minimum": 1 },
        "status": { "type": "string", "enum": ["not_requested", "planned"] }
      }
    },
    "vector_store": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "name", "external_store_id", "status"],
      "properties": {
        "provider": { "type": "string", "enum": ["none", "openai_file_search", "local"] },
        "name": { "type": "string", "minLength": 1 },
        "external_store_id": { "type": ["string", "null"] },
        "status": { "type": "string", "enum": ["not_created"] }
      }
    },
    "provider_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_admission_review_id",
        "resource_admission_review_id",
        "capability_allowed",
        "resource_allowed",
        "provider_call_allowed",
        "vector_write_allowed",
        "process_start_allowed"
      ],
      "properties": {
        "capability_admission_review_id": { "type": ["string", "null"] },
        "resource_admission_review_id": { "type": ["string", "null"] },
        "capability_allowed": { "type": "boolean" },
        "resource_allowed": { "type": "boolean" },
        "provider_call_allowed": { "type": "boolean", "const": false },
        "vector_write_allowed": { "type": "boolean", "const": false },
        "process_start_allowed": { "type": "boolean", "const": false }
      }
    },
    "downloaded_artifact_quarantine_ids": { "type": "array", "items": { "type": "string" } },
    "planned_batches": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["batch_id", "batch_index", "chunk_ids", "chunk_count", "status"],
        "properties": {
          "batch_id": { "type": "string", "minLength": 1 },
          "batch_index": { "type": "integer", "minimum": 0 },
          "chunk_ids": { "type": "array", "items": { "type": "string" } },
          "chunk_count": { "type": "integer", "minimum": 0 },
          "status": { "type": "string", "enum": ["planned"] }
        }
      }
    },
    "planned_vectors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "vector_ref_id",
          "chunk_id",
          "source_path",
          "chunk_index",
          "chunk_sha256",
          "embedding_status",
          "vector_status"
        ],
        "properties": {
          "vector_ref_id": { "type": "string", "minLength": 1 },
          "chunk_id": { "type": "string", "minLength": 1 },
          "source_path": { "type": "string", "minLength": 1 },
          "chunk_index": { "type": "integer", "minimum": 0 },
          "chunk_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "embedding_status": { "type": "string", "enum": ["planned"] },
          "vector_status": { "type": "string", "enum": ["not_written"] }
        }
      }
    },
    "batch_count": { "type": "integer", "minimum": 0 },
    "chunk_count": { "type": "integer", "minimum": 0 },
    "idempotency_key": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["blocked", "ready_for_operator_review"] },
    "reason_codes": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "created_at": { "type": "string" },
    "job_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
