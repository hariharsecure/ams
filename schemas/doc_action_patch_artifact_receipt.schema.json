        "patch_artifacts_written": { "type": "boolean" },
        "source_hashes_match_patch_preview": { "type": "boolean" },
        "artifact_paths_outside_source_root": { "type": "boolean" },
        "artifact_hashes_present": { "type": "boolean" },
        "raw_patch_not_stored_in_ams_state": { "type": "boolean" },
        "source_files_not_modified": { "type": "boolean" },
