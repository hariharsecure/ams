{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ams:ams-codex:incident-packet:v0",
  "title": "AMSCodexIncidentPacket",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "incident_packet_id",
    "trigger",
    "task_run_id",
    "session_id",
    "ids",
    "last_events",
    "policy_hashes",
    "store_revision",
    "predicate_results",
    "compaction_epoch",
    "created_at",
    "incident_sha256"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "ams.ams_codex.incident_packet.v0" },
    "incident_packet_id": { "type": "string", "minLength": 1 },
    "trigger": { "type": "string", "minLength": 1 },
    "task_run_id": { "type": ["string", "null"] },
    "session_id": { "type": ["string", "null"] },
    "ids": { "type": "object", "additionalProperties": true },
    "last_events": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "policy_hashes": { "type": "array", "items": { "type": "string" } },
    "store_revision": { "type": "integer", "minimum": 0 },
    "predicate_results": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "compaction_epoch": { "type": "integer", "minimum": 0 },
    "reason_codes": { "type": "array", "items": { "type": "string" } },
    "created_at": { "type": "string", "format": "date-time" },
    "incident_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
