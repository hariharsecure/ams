{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ams:ams:generated-status-snapshot:v0",
  "title": "AMSGeneratedStatusSnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_status_snapshot_id",
    "label",
    "source_root",
    "output_path",
    "output_path_relative",
    "line_budget",
    "source_plan_ref",
    "rendered",
    "write_result",
    "dangerous_boundaries",
    "generated_status_summary",
    "remaining_doc_actions",
    "status",
    "reason_codes",
    "created_at",
    "generated_status_snapshot_sha256"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "ams.ams.generated_status_snapshot.v0" },
    "generated_status_snapshot_id": { "type": "string", "minLength": 1 },
    "label": { "type": "string", "minLength": 1 },
    "source_root": { "type": "string", "minLength": 1 },
    "output_path": { "type": "string", "minLength": 1 },
    "output_path_relative": { "type": "string", "minLength": 1 },
    "line_budget": { "type": "integer", "minimum": 1 },
    "source_plan_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "doc_retirement_plan_id",
        "doc_retirement_plan_sha256",
        "status",
        "action_count",
        "generated_status_latest_milestone_doc"
      ],
      "properties": {
        "doc_retirement_plan_id": { "type": "string", "minLength": 1 },
        "doc_retirement_plan_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "status": { "type": "string", "enum": ["allow", "defer", "deny"] },
        "action_count": { "type": "integer", "minimum": 0 },
        "generated_status_latest_milestone_doc": { "type": ["string", "null"] }
      }
    },
    "rendered": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "line_count", "size_bytes", "within_line_budget", "raw_content_stored_in_record"],
      "properties": {
        "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "line_count": { "type": "integer", "minimum": 0 },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "within_line_budget": { "type": "boolean" },
        "raw_content_stored_in_record": { "type": "boolean", "const": false }
      }
    },
    "write_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "write_requested",
        "write_performed",
        "allow_overwrite",
        "previous_file_exists",
        "previous_file_sha256",
        "output_already_current",
        "created_new_file",
        "rewrote_existing_generated_file"
      ],
      "properties": {
        "write_requested": { "type": "boolean" },
        "write_performed": { "type": "boolean" },
        "allow_overwrite": { "type": "boolean" },
        "previous_file_exists": { "type": "boolean" },
        "previous_file_sha256": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" },
        "output_already_current": { "type": "boolean" },
        "created_new_file": { "type": "boolean" },
        "rewrote_existing_generated_file": { "type": "boolean" }
      }
    },
    "dangerous_boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_file_deleted",
        "source_file_moved",
        "source_file_rewritten",
        "raw_source_markdown_stored",
        "raw_session_content_stored",
        "prompt_text_stored",
        "transcript_text_stored",
        "network_call_performed"
      ],
      "properties": {
        "source_file_deleted": { "type": "boolean", "const": false },
        "source_file_moved": { "type": "boolean", "const": false },
        "source_file_rewritten": { "type": "boolean", "const": false },
        "raw_source_markdown_stored": { "type": "boolean", "const": false },
        "raw_session_content_stored": { "type": "boolean", "const": false },
        "prompt_text_stored": { "type": "boolean", "const": false },
        "transcript_text_stored": { "type": "boolean", "const": false },
        "network_call_performed": { "type": "boolean", "const": false }
      }
    },
    "generated_status_summary": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "recommended_path",
        "latest_milestone_doc",
        "markdown_file_count",
        "total_line_count",
        "metadata_gap_count",
        "structure_gap_count",
        "oversized_file_count",
        "raw_content_stored"
      ],
      "properties": {
        "recommended_path": { "type": "string", "minLength": 1 },
        "latest_milestone_doc": { "type": ["string", "null"] },
        "markdown_file_count": { "type": "integer", "minimum": 0 },
        "total_line_count": { "type": "integer", "minimum": 0 },
        "metadata_gap_count": { "type": "integer", "minimum": 0 },
        "structure_gap_count": { "type": "integer", "minimum": 0 },
        "oversized_file_count": { "type": "integer", "minimum": 0 },
        "raw_content_stored": { "type": "boolean", "const": false }
      }
    },
    "remaining_doc_actions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action_count", "by_kind", "by_severity", "operator_review_required_count"],
      "properties": {
        "action_count": { "type": "integer", "minimum": 0 },
        "by_kind": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "by_severity": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "operator_review_required_count": { "type": "integer", "minimum": 0 }
      }
    },
    "status": { "type": "string", "enum": ["allow", "defer", "deny"] },
    "reason_codes": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "created_at": { "type": "string", "minLength": 1 },
    "generated_status_snapshot_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
