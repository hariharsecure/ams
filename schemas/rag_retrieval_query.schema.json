{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ams:ams:rag-retrieval-query:v0",
  "title": "AMSRAGRetrievalQuery",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "rag_retrieval_query_id",
    "rag_embedding_receipt_id",
    "rag_embedding_receipt_sha256",
    "rag_embedding_job_id",
    "rag_embedding_job_sha256",
    "rag_index_plan_id",
    "rag_index_plan_sha256",
    "collection",
    "query_sha256",
    "query_length",
    "query_ref",
    "query_text_stored",
    "raw_corpus_stored",
    "retrieval_mode",
    "retrieval_provider",
    "top_k",
    "taint_labels",
    "source_refs",
    "source_ref_count",
    "status",
    "reason_codes",
    "created_at",
    "retrieval_query_sha256"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "ams.ams.rag_retrieval_query.v0" },
    "rag_retrieval_query_id": { "type": "string", "minLength": 1 },
    "rag_embedding_receipt_id": { "type": "string", "minLength": 1 },
    "rag_embedding_receipt_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "rag_embedding_job_id": { "type": "string", "minLength": 1 },
    "rag_embedding_job_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "rag_index_plan_id": { "type": "string", "minLength": 1 },
    "rag_index_plan_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "collection": { "type": "string", "minLength": 1 },
    "query_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "query_length": { "type": "integer", "minimum": 0 },
    "query_ref": { "type": ["string", "null"] },
    "query_text_stored": { "type": "boolean", "const": false },
    "raw_corpus_stored": { "type": "boolean", "const": false },
    "retrieval_mode": { "type": "string", "enum": ["planned_only", "simulated_refs", "external_observed"] },
    "retrieval_provider": { "type": "string", "enum": ["none", "openai_file_search", "local"] },
    "top_k": { "type": "integer", "minimum": 0 },
    "taint_labels": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "retrieval_source_ref_id",
          "rank",
          "chunk_id",
          "source_path",
          "chunk_sha256",
          "vector_ref_id",
          "vector_receipt_status",
          "score_ref_sha256",
          "taint_labels",
          "content_stored"
        ],
        "properties": {
          "retrieval_source_ref_id": { "type": "string", "minLength": 1 },
          "rank": { "type": "integer", "minimum": 1 },
          "chunk_id": { "type": "string", "minLength": 1 },
          "source_path": { "type": "string", "minLength": 1 },
          "chunk_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "vector_ref_id": { "type": "string", "minLength": 1 },
          "vector_receipt_status": { "type": "string", "enum": ["simulated", "external_observed"] },
          "score_ref_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "taint_labels": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true },
          "content_stored": { "type": "boolean", "const": false }
        }
      }
    },
    "source_ref_count": { "type": "integer", "minimum": 0 },
    "status": { "type": "string", "enum": ["blocked", "ready_for_operator_review"] },
    "reason_codes": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "created_at": { "type": "string" },
    "retrieval_query_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
