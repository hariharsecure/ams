{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ams:ams:semantic-hook-operator-approval-packet:v0",
  "title": "AMSSemanticHookOperatorApprovalPacket",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "semantic_hook_operator_approval_packet_id",
    "label",
    "source_root",
    "semantic_hook_install_transaction_id",
    "semantic_hook_install_transaction_sha256",
    "semantic_hook_target_snapshot_id",
    "semantic_hook_target_snapshot_sha256",
    "semantic_hook_approval_binding_id",
    "semantic_hook_approval_binding_sha256",
    "semantic_hook_install_plan_id",
    "semantic_hook_install_plan_sha256",
    "semantic_hook_run_id",
    "semantic_hook_run_sha256",
    "transaction_summary",
    "provenance_summary",
    "freshness",
    "approval_request",
    "required_gates",
    "approval_granted",
    "live_install_allowed",
    "hook_file_write_allowed",
    "hook_trust_allowed",
    "provider_hook_execution_allowed",
    "backup_write_allowed",
    "restore_allowed",
    "approval_actions",
    "install_actions",
    "trust_actions",
    "start_actions",
    "live_boundaries",
    "status",
    "reason_codes",
    "created_at",
    "semantic_hook_operator_approval_packet_sha256"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "ams.ams.semantic_hook_operator_approval_packet.v0" },
    "semantic_hook_operator_approval_packet_id": { "type": "string", "minLength": 1 },
    "label": { "type": "string", "minLength": 1 },
    "source_root": { "type": "string", "minLength": 1 },
    "semantic_hook_install_transaction_id": { "type": "string", "minLength": 1 },
    "semantic_hook_install_transaction_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "semantic_hook_target_snapshot_id": { "type": "string", "minLength": 1 },
    "semantic_hook_target_snapshot_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "semantic_hook_approval_binding_id": { "type": "string", "minLength": 1 },
    "semantic_hook_approval_binding_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "semantic_hook_install_plan_id": { "type": "string", "minLength": 1 },
    "semantic_hook_install_plan_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "semantic_hook_run_id": { "type": "string", "minLength": 1 },
    "semantic_hook_run_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "transaction_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_count",
        "payload_rendering_count",
        "install_step_count",
        "rollback_step_count",
        "trust_review_step_count",
        "payloads",
        "payload_hashes_match",
        "install_steps_atomic",
        "rollback_steps_inert",
        "trust_steps_inert"
      ],
      "properties": {
        "target_count": { "type": ["integer", "null"], "minimum": 0 },
        "payload_rendering_count": { "type": "integer", "minimum": 0 },
        "install_step_count": { "type": "integer", "minimum": 0 },
        "rollback_step_count": { "type": "integer", "minimum": 0 },
        "trust_review_step_count": { "type": "integer", "minimum": 0 },
        "payloads": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "target",
              "resolved_path",
              "payload_source",
              "payload_sha256",
              "expected_config_sha256",
              "raw_payload_stored",
              "secret_stored",
              "write_performed"
            ],
            "properties": {
              "target": { "type": ["string", "null"] },
              "resolved_path": { "type": ["string", "null"] },
              "payload_source": { "type": ["string", "null"] },
              "payload_sha256": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" },
              "expected_config_sha256": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" },
              "raw_payload_stored": { "type": "boolean", "const": false },
              "secret_stored": { "type": "boolean", "const": false },
              "write_performed": { "type": "boolean", "const": false }
            }
          }
        },
        "payload_hashes_match": { "type": "boolean" },
        "install_steps_atomic": { "type": "boolean" },
        "rollback_steps_inert": { "type": "boolean" },
        "trust_steps_inert": { "type": "boolean" }
      }
    },
    "provenance_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signed_package_verified",
        "signature_verified",
        "signer_identity",
        "signer_fingerprint",
        "signer_fingerprint_pinned",
        "package_manifest_sha256",
        "manifest_declares_exact_install_plan",
        "manifest_declares_exact_hook_run",
        "manifest_declares_exact_codex_preview",
        "manifest_declares_exact_claude_preview",
        "rollback_proof_present",
        "rollback_preflight_passed"
      ],
      "properties": {
        "signed_package_verified": { "type": "boolean" },
        "signature_verified": { "type": "boolean" },
        "signer_identity": { "type": ["string", "null"] },
        "signer_fingerprint": { "type": ["string", "null"] },
        "signer_fingerprint_pinned": { "type": "boolean" },
        "package_manifest_sha256": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" },
        "manifest_declares_exact_install_plan": { "type": "boolean" },
        "manifest_declares_exact_hook_run": { "type": "boolean" },
        "manifest_declares_exact_codex_preview": { "type": "boolean" },
        "manifest_declares_exact_claude_preview": { "type": "boolean" },
        "rollback_proof_present": { "type": "boolean" },
        "rollback_preflight_passed": { "type": "boolean" }
      }
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_snapshot_hash_current",
        "approval_binding_hash_current",
        "install_plan_hash_current",
        "hook_run_hash_current"
      ],
      "properties": {
        "target_snapshot_hash_current": { "type": "boolean" },
        "approval_binding_hash_current": { "type": "boolean" },
        "install_plan_hash_current": { "type": "boolean" },
        "hook_run_hash_current": { "type": "boolean" }
      }
    },
    "approval_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested_decision",
        "operator_readback_captured",
        "raw_readback_stored",
        "required_review_steps",
        "required_readback_phrases",
        "approval_granted_by_packet",
        "live_install_allowed_by_packet",
        "hook_write_allowed_by_packet",
        "hook_trust_allowed_by_packet",
        "provider_hook_execution_allowed_by_packet"
      ],
      "properties": {
        "requested_decision": { "type": "string", "const": "operator_review_required" },
        "operator_readback_captured": { "type": "boolean", "const": false },
        "raw_readback_stored": { "type": "boolean", "const": false },
        "required_review_steps": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true },
        "required_readback_phrases": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true },
        "approval_granted_by_packet": { "type": "boolean", "const": false },
        "live_install_allowed_by_packet": { "type": "boolean", "const": false },
        "hook_write_allowed_by_packet": { "type": "boolean", "const": false },
        "hook_trust_allowed_by_packet": { "type": "boolean", "const": false },
        "provider_hook_execution_allowed_by_packet": { "type": "boolean", "const": false }
      }
    },
    "required_gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transaction_ready",
        "transaction_inert",
        "target_snapshot_ready",
        "approval_binding_ready",
        "install_plan_ready",
        "hook_run_allow",
        "target_snapshot_fresh",
        "approval_binding_fresh",
        "install_plan_fresh",
        "hook_run_fresh",
        "signed_package_verified",
        "signature_verified",
        "pinned_signer_verified",
        "manifest_declares_exact_artifacts",
        "rollback_proof_present",
        "rollback_preflight_passed",
        "target_count_matches",
        "payload_hashes_match",
        "install_steps_atomic",
        "rollback_steps_inert",
        "trust_steps_inert",
        "trust_review_present",
        "operator_readback_not_captured",
        "approval_granted_false",
        "live_install_allowed_false"
      ],
      "properties": {
        "transaction_ready": { "type": "boolean" },
        "transaction_inert": { "type": "boolean" },
        "target_snapshot_ready": { "type": "boolean" },
        "approval_binding_ready": { "type": "boolean" },
        "install_plan_ready": { "type": "boolean" },
        "hook_run_allow": { "type": "boolean" },
        "target_snapshot_fresh": { "type": "boolean" },
        "approval_binding_fresh": { "type": "boolean" },
        "install_plan_fresh": { "type": "boolean" },
        "hook_run_fresh": { "type": "boolean" },
        "signed_package_verified": { "type": "boolean" },
        "signature_verified": { "type": "boolean" },
        "pinned_signer_verified": { "type": "boolean" },
        "manifest_declares_exact_artifacts": { "type": "boolean" },
        "rollback_proof_present": { "type": "boolean" },
        "rollback_preflight_passed": { "type": "boolean" },
        "target_count_matches": { "type": "boolean" },
        "payload_hashes_match": { "type": "boolean" },
        "install_steps_atomic": { "type": "boolean" },
        "rollback_steps_inert": { "type": "boolean" },
        "trust_steps_inert": { "type": "boolean" },
        "trust_review_present": { "type": "boolean" },
        "operator_readback_not_captured": { "type": "boolean" },
        "approval_granted_false": { "type": "boolean", "const": true },
        "live_install_allowed_false": { "type": "boolean", "const": true }
      }
    },
    "approval_granted": { "type": "boolean", "const": false },
    "live_install_allowed": { "type": "boolean", "const": false },
    "hook_file_write_allowed": { "type": "boolean", "const": false },
    "hook_trust_allowed": { "type": "boolean", "const": false },
    "provider_hook_execution_allowed": { "type": "boolean", "const": false },
    "backup_write_allowed": { "type": "boolean", "const": false },
    "restore_allowed": { "type": "boolean", "const": false },
    "approval_actions": { "type": "array", "maxItems": 0 },
    "install_actions": { "type": "array", "maxItems": 0 },
    "trust_actions": { "type": "array", "maxItems": 0 },
    "start_actions": { "type": "array", "maxItems": 0 },
    "live_boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approval_granted",
        "hook_file_written",
        "hook_installed",
        "hook_trusted",
        "provider_hook_executed",
        "backup_file_written",
        "restore_performed",
        "discord_call_performed",
        "terminal_attach_performed",
        "terminal_capture_performed",
        "terminal_injection_performed",
        "persistent_process_started",
        "provider_call_performed",
        "network_call_performed",
        "raw_payload_stored",
        "raw_readback_stored",
        "secret_stored"
      ],
      "properties": {
        "approval_granted": { "type": "boolean", "const": false },
        "hook_file_written": { "type": "boolean", "const": false },
        "hook_installed": { "type": "boolean", "const": false },
        "hook_trusted": { "type": "boolean", "const": false },
        "provider_hook_executed": { "type": "boolean", "const": false },
        "backup_file_written": { "type": "boolean", "const": false },
        "restore_performed": { "type": "boolean", "const": false },
        "discord_call_performed": { "type": "boolean", "const": false },
        "terminal_attach_performed": { "type": "boolean", "const": false },
        "terminal_capture_performed": { "type": "boolean", "const": false },
        "terminal_injection_performed": { "type": "boolean", "const": false },
        "persistent_process_started": { "type": "boolean", "const": false },
        "provider_call_performed": { "type": "boolean", "const": false },
        "network_call_performed": { "type": "boolean", "const": false },
        "raw_payload_stored": { "type": "boolean", "const": false },
        "raw_readback_stored": { "type": "boolean", "const": false },
        "secret_stored": { "type": "boolean", "const": false }
      }
    },
    "status": { "type": "string", "enum": ["ready_for_operator_review", "blocked"] },
    "reason_codes": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "semantic_hook_operator_approval_packet_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
