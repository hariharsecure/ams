{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ams:ams-codex:semantic-hook-operator-readback-receipt:v0",
  "title": "AMSCodexSemanticHookOperatorReadbackReceipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "semantic_hook_operator_readback_receipt_id",
    "label",
    "source_root",
    "semantic_hook_operator_approval_packet_id",
    "semantic_hook_operator_approval_packet_sha256",
    "semantic_hook_install_transaction_id",
    "semantic_hook_install_transaction_sha256",
    "readback",
    "required_readback_phrases",
    "required_gates",
    "receipt_verifies_readback_only",
    "approval_granted",
    "live_install_allowed",
    "hook_file_write_allowed",
    "hook_trust_allowed",
    "provider_hook_execution_allowed",
    "backup_write_allowed",
    "restore_allowed",
    "approval_actions",
    "install_actions",
    "trust_actions",
    "start_actions",
    "live_boundaries",
    "status",
    "reason_codes",
    "created_at",
    "semantic_hook_operator_readback_receipt_sha256"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "ams.ams_codex.semantic_hook_operator_readback_receipt.v0" },
    "semantic_hook_operator_readback_receipt_id": { "type": "string", "minLength": 1 },
    "label": { "type": "string", "minLength": 1 },
    "source_root": { "type": "string", "minLength": 1 },
    "semantic_hook_operator_approval_packet_id": { "type": "string", "minLength": 1 },
    "semantic_hook_operator_approval_packet_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "semantic_hook_install_transaction_id": { "type": "string", "minLength": 1 },
    "semantic_hook_install_transaction_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "readback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested_by",
        "readback_ref",
        "readback_present",
        "readback_text_sha256",
        "normalized_readback_sha256",
        "raw_readback_stored",
        "phrase_results",
        "required_phrases_present",
        "missing_required_phrases",
        "created_at"
      ],
      "properties": {
        "requested_by": { "type": "string", "minLength": 1 },
        "readback_ref": { "type": "string", "minLength": 1 },
        "readback_present": { "type": "boolean" },
        "readback_text_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "normalized_readback_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "raw_readback_stored": { "type": "boolean", "const": false },
        "phrase_results": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["phrase", "present", "evidence_sha256"],
            "properties": {
              "phrase": { "type": "string", "minLength": 1 },
              "present": { "type": "boolean" },
              "evidence_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
            }
          }
        },
        "required_phrases_present": { "type": "boolean" },
        "missing_required_phrases": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "created_at": { "type": "string", "minLength": 1 }
      }
    },
    "required_readback_phrases": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true },
    "required_gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operator_packet_present",
        "operator_packet_ready",
        "operator_packet_hash_current",
        "operator_packet_grants_no_authority",
        "readback_ref_present",
        "readback_present",
        "required_phrases_present",
        "raw_readback_not_stored",
        "receipt_grants_no_authority"
      ],
      "properties": {
        "operator_packet_present": { "type": "boolean" },
        "operator_packet_ready": { "type": "boolean" },
        "operator_packet_hash_current": { "type": "boolean" },
        "operator_packet_grants_no_authority": { "type": "boolean" },
        "readback_ref_present": { "type": "boolean" },
        "readback_present": { "type": "boolean" },
        "required_phrases_present": { "type": "boolean" },
        "raw_readback_not_stored": { "type": "boolean" },
        "receipt_grants_no_authority": { "type": "boolean", "const": true }
      }
    },
    "receipt_verifies_readback_only": { "type": "boolean", "const": true },
    "approval_granted": { "type": "boolean", "const": false },
    "live_install_allowed": { "type": "boolean", "const": false },
    "hook_file_write_allowed": { "type": "boolean", "const": false },
    "hook_trust_allowed": { "type": "boolean", "const": false },
    "provider_hook_execution_allowed": { "type": "boolean", "const": false },
    "backup_write_allowed": { "type": "boolean", "const": false },
    "restore_allowed": { "type": "boolean", "const": false },
    "approval_actions": { "type": "array", "maxItems": 0 },
    "install_actions": { "type": "array", "maxItems": 0 },
    "trust_actions": { "type": "array", "maxItems": 0 },
    "start_actions": { "type": "array", "maxItems": 0 },
    "live_boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approval_granted",
        "hook_file_written",
        "hook_installed",
        "hook_trusted",
        "provider_hook_executed",
        "backup_file_written",
        "restore_performed",
        "discord_call_performed",
        "terminal_attach_performed",
        "terminal_capture_performed",
        "terminal_injection_performed",
        "persistent_process_started",
        "provider_call_performed",
        "network_call_performed",
        "raw_payload_stored",
        "raw_readback_stored",
        "secret_stored"
      ],
      "properties": {
        "approval_granted": { "type": "boolean", "const": false },
        "hook_file_written": { "type": "boolean", "const": false },
        "hook_installed": { "type": "boolean", "const": false },
        "hook_trusted": { "type": "boolean", "const": false },
        "provider_hook_executed": { "type": "boolean", "const": false },
        "backup_file_written": { "type": "boolean", "const": false },
        "restore_performed": { "type": "boolean", "const": false },
        "discord_call_performed": { "type": "boolean", "const": false },
        "terminal_attach_performed": { "type": "boolean", "const": false },
        "terminal_capture_performed": { "type": "boolean", "const": false },
        "terminal_injection_performed": { "type": "boolean", "const": false },
        "persistent_process_started": { "type": "boolean", "const": false },
        "provider_call_performed": { "type": "boolean", "const": false },
        "network_call_performed": { "type": "boolean", "const": false },
        "raw_payload_stored": { "type": "boolean", "const": false },
        "raw_readback_stored": { "type": "boolean", "const": false },
        "secret_stored": { "type": "boolean", "const": false }
      }
    },
    "status": { "type": "string", "enum": ["readback_verified", "blocked"] },
    "reason_codes": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "created_at": { "type": "string", "minLength": 1 },
    "semantic_hook_operator_readback_receipt_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
