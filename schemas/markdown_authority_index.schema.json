{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ams:ams-codex:markdown-authority-index:v0",
  "title": "AMSCodexMarkdownAuthorityIndex",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "markdown_authority_index_id",
    "label",
    "source_root",
    "scan_mode",
    "network_required",
    "raw_markdown_stored",
    "markdown_file_count",
    "total_line_count",
    "total_size_bytes",
    "markdown_snapshot_sha256",
    "entry_refs",
    "latest_milestone_doc",
    "startup_surface",
    "generated_status",
    "policy",
    "supersession_edges",
    "status",
    "reason_codes",
    "created_at",
    "markdown_authority_index_sha256"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "ams.ams_codex.markdown_authority_index.v0" },
    "markdown_authority_index_id": { "type": "string", "minLength": 1 },
    "label": { "type": "string", "minLength": 1 },
    "source_root": { "type": "string", "minLength": 1 },
    "scan_mode": { "type": "string", "enum": ["markdown_authority_hash_only"] },
    "network_required": { "type": "boolean", "const": false },
    "raw_markdown_stored": { "type": "boolean", "const": false },
    "markdown_file_count": { "type": "integer", "minimum": 0 },
    "total_line_count": { "type": "integer", "minimum": 0 },
    "total_size_bytes": { "type": "integer", "minimum": 0 },
    "markdown_snapshot_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "entry_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "markdown_authority_entry_id", "markdown_authority_entry_sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "markdown_authority_entry_id": { "type": "string", "minLength": 1 },
          "markdown_authority_entry_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
        }
      }
    },
    "latest_milestone_doc": { "type": ["string", "null"] },
    "startup_surface": { "type": "array", "items": { "type": "string" } },
    "generated_status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "exists",
        "sha256",
        "latest_milestone_doc",
        "computed_latest_milestone_doc",
        "matches_computed_latest",
        "raw_content_stored"
      ],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "exists": { "type": "boolean" },
        "sha256": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" },
        "latest_milestone_doc": { "type": ["string", "null"] },
        "computed_latest_milestone_doc": { "type": ["string", "null"] },
        "matches_computed_latest": { "type": "boolean" },
        "raw_content_stored": { "type": "boolean", "const": false }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_startup_paths",
        "startup_authority_levels",
        "raw_markdown_stored",
        "raw_session_content_stored",
        "prompt_text_stored",
        "transcript_text_stored",
        "embedding_payload_stored",
        "vector_payload_stored"
      ],
      "properties": {
        "required_startup_paths": { "type": "array", "items": { "type": "string" } },
        "startup_authority_levels": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "raw_markdown_stored": { "type": "boolean", "const": false },
        "raw_session_content_stored": { "type": "boolean", "const": false },
        "prompt_text_stored": { "type": "boolean", "const": false },
        "transcript_text_stored": { "type": "boolean", "const": false },
        "embedding_payload_stored": { "type": "boolean", "const": false },
        "vector_payload_stored": { "type": "boolean", "const": false }
      }
    },
    "supersession_edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["old_path", "new_path", "mode"],
        "properties": {
          "old_path": { "type": "string", "minLength": 1 },
          "new_path": { "type": "string", "minLength": 1 },
          "mode": { "type": "string", "enum": ["correction", "temporal_update", "scope_refinement", "revocation", "duplicate"] }
        }
      }
    },
    "status": { "type": "string", "enum": ["allow", "defer", "deny"] },
    "reason_codes": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "created_at": { "type": "string", "minLength": 1 },
    "markdown_authority_index_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
