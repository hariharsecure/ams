{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ams:ams:semantic-oracle-review:v0",
  "title": "AMSSemanticOracleReview",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "semantic_oracle_review_id",
    "label",
    "source_root",
    "simulation_sweep_id",
    "simulation_sweep_sha256",
    "scenario_artifact",
    "reviewed_scenario_count",
    "semantic_rules",
    "rule_results",
    "hook_shim_contract",
    "metrics",
    "research_basis",
    "live_boundaries",
    "artifacts",
    "status",
    "reason_codes",
    "created_at",
    "semantic_oracle_review_sha256"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "ams.ams.semantic_oracle_review.v0" },
    "semantic_oracle_review_id": { "type": "string", "minLength": 1 },
    "label": { "type": "string", "minLength": 1 },
    "source_root": { "type": "string", "minLength": 1 },
    "simulation_sweep_id": { "type": "string", "minLength": 1 },
    "simulation_sweep_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "scenario_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "const": "scenario_results_jsonl" },
        "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "reviewed_scenario_count": { "type": "integer", "minimum": 1 },
    "semantic_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rule_id",
          "fault",
          "required_features",
          "required_hooks",
          "required_records",
          "closes_research_need"
        ],
        "properties": {
          "rule_id": { "type": "string", "minLength": 1 },
          "fault": { "type": "string", "minLength": 1 },
          "required_features": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true },
          "required_hooks": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true },
          "required_records": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true },
          "closes_research_need": { "type": "string", "minLength": 1 }
        }
      }
    },
    "rule_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rule_id",
          "fault",
          "matched_scenarios",
          "covered_scenarios",
          "semantic_gap_count",
          "sample_gaps",
          "status",
          "required_hooks",
          "required_records",
          "closes_research_need"
        ],
        "properties": {
          "rule_id": { "type": "string", "minLength": 1 },
          "fault": { "type": "string", "minLength": 1 },
          "matched_scenarios": { "type": "integer", "minimum": 0 },
          "covered_scenarios": { "type": "integer", "minimum": 0 },
          "semantic_gap_count": { "type": "integer", "minimum": 0 },
          "sample_gaps": { "type": "array", "items": { "type": "object" } },
          "status": { "type": "string", "enum": ["allow", "defer"] },
          "required_hooks": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true },
          "required_records": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true },
          "closes_research_need": { "type": "string", "minLength": 1 }
        }
      }
    },
    "hook_shim_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enforcement_mode",
        "live_installed",
        "required_hooks",
        "required_records",
        "preflight_commands",
        "reason_code"
      ],
      "properties": {
        "enforcement_mode": { "type": "string", "const": "contract_only" },
        "live_installed": { "type": "boolean", "const": false },
        "required_hooks": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true },
        "required_records": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true },
        "preflight_commands": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "reason_code": { "type": "string", "minLength": 1 }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewed_scenario_count",
        "reviewed_fault_distribution",
        "semantic_rule_count",
        "semantic_matched_scenario_count",
        "semantic_covered_scenario_count",
        "semantic_gap_count",
        "semantic_gap_rate",
        "hook_required_count",
        "record_requirement_count"
      ],
      "properties": {
        "reviewed_scenario_count": { "type": "integer", "minimum": 1 },
        "reviewed_fault_distribution": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "semantic_rule_count": { "type": "integer", "minimum": 1 },
        "semantic_matched_scenario_count": { "type": "integer", "minimum": 0 },
        "semantic_covered_scenario_count": { "type": "integer", "minimum": 0 },
        "semantic_gap_count": { "type": "integer", "minimum": 0 },
        "semantic_gap_rate": { "type": "number", "minimum": 0 },
        "hook_required_count": { "type": "integer", "minimum": 0 },
        "record_requirement_count": { "type": "integer", "minimum": 0 }
      }
    },
    "research_basis": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["lens", "source", "url"],
        "properties": {
          "lens": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "minLength": 1 }
        }
      }
    },
    "live_boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "discord_call_performed",
        "terminal_attach_performed",
        "terminal_capture_performed",
        "terminal_injection_performed",
        "persistent_process_started",
        "provider_call_performed",
        "embedding_call_performed",
        "vector_write_performed",
        "network_call_performed",
        "raw_content_stored",
        "secret_stored",
        "hook_installed"
      ],
      "properties": {
        "discord_call_performed": { "type": "boolean", "const": false },
        "terminal_attach_performed": { "type": "boolean", "const": false },
        "terminal_capture_performed": { "type": "boolean", "const": false },
        "terminal_injection_performed": { "type": "boolean", "const": false },
        "persistent_process_started": { "type": "boolean", "const": false },
        "provider_call_performed": { "type": "boolean", "const": false },
        "embedding_call_performed": { "type": "boolean", "const": false },
        "vector_write_performed": { "type": "boolean", "const": false },
        "network_call_performed": { "type": "boolean", "const": false },
        "raw_content_stored": { "type": "boolean", "const": false },
        "secret_stored": { "type": "boolean", "const": false },
        "hook_installed": { "type": "boolean", "const": false }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "kind", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
        }
      }
    },
    "status": { "type": "string", "enum": ["allow", "defer", "deny"] },
    "reason_codes": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "created_at": { "type": "string", "minLength": 1 },
    "semantic_oracle_review_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
