{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ams:ams:terminal-source-packet:v0",
  "title": "AMSTerminalSourcePacket",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "terminal_source_packet_id",
    "source_surface",
    "source_kind",
    "source_ref",
    "runtime_surface_id",
    "host_id",
    "terminal_session_id",
    "tmux_session_name",
    "tmux_window_id",
    "tmux_pane_id",
    "source_event_id",
    "source_actor",
    "observed_at",
    "ingest_mode",
    "observation_mode",
    "read_only",
    "monitor_started",
    "attach_performed",
    "capture_performed",
    "command_input_allowed",
    "keystroke_injection_allowed",
    "process_signal_allowed",
    "token_stored",
    "raw_content_stored",
    "content_sha256",
    "content_length",
    "summary",
    "summary_sha256",
    "artifact_refs",
    "artifact_count",
    "forbidden_secret_key_count",
    "forbidden_injection_key_count",
    "input_shape_sha256",
    "attention_signal_created",
    "attention_signal_id",
    "attention_signal_sha256",
    "status",
    "reason_codes",
    "created_at",
    "source_packet_sha256"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "ams.ams.terminal_source_packet.v0" },
    "terminal_source_packet_id": { "type": "string", "minLength": 1 },
    "source_surface": { "type": "string", "enum": ["terminal", "tmux"] },
    "source_kind": { "type": "string", "minLength": 1 },
    "source_ref": { "type": "string", "pattern": "^(terminal|tmux)://.+" },
    "runtime_surface_id": { "type": ["string", "null"] },
    "host_id": { "type": ["string", "null"] },
    "terminal_session_id": { "type": "string", "minLength": 1 },
    "tmux_session_name": { "type": ["string", "null"] },
    "tmux_window_id": { "type": ["string", "null"] },
    "tmux_pane_id": { "type": ["string", "null"] },
    "source_event_id": { "type": "string", "minLength": 1 },
    "source_actor": { "type": ["string", "null"] },
    "observed_at": { "type": "string" },
    "ingest_mode": { "type": "string", "const": "source_packet" },
    "observation_mode": {
      "type": "string",
      "enum": ["external_observed", "operator_supplied", "simulated_success"]
    },
    "read_only": { "type": "boolean", "const": true },
    "monitor_started": { "type": "boolean", "const": false },
    "attach_performed": { "type": "boolean", "const": false },
    "capture_performed": { "type": "boolean", "const": false },
    "command_input_allowed": { "type": "boolean", "const": false },
    "keystroke_injection_allowed": { "type": "boolean", "const": false },
    "process_signal_allowed": { "type": "boolean", "const": false },
    "token_stored": { "type": "boolean", "const": false },
    "raw_content_stored": { "type": "boolean", "const": false },
    "content_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "content_length": { "type": "integer", "minimum": 0 },
    "summary": { "type": "string" },
    "summary_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "artifact_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref", "kind", "sha256"],
        "properties": {
          "ref": { "type": "string", "minLength": 1 },
          "kind": { "type": ["string", "null"] },
          "sha256": { "type": ["string", "null"] }
        }
      }
    },
    "artifact_count": { "type": "integer", "minimum": 0 },
    "forbidden_secret_key_count": { "type": "integer", "minimum": 0 },
    "forbidden_injection_key_count": { "type": "integer", "minimum": 0 },
    "input_shape_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "attention_signal_created": { "type": "boolean" },
    "attention_signal_id": { "type": ["string", "null"] },
    "attention_signal_sha256": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" },
    "status": { "type": "string", "enum": ["ready_for_attention", "blocked"] },
    "reason_codes": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "source_packet_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
