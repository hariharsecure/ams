{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ams:ams-codex:store-backup-drill:v0",
  "title": "AMSCodexStoreBackupDrill",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "store_backup_drill_id",
    "label",
    "source_store_path",
    "backup_snapshot_path",
    "restore_store_path",
    "source_state_sha256",
    "backup_state_sha256",
    "restore_state_sha256",
    "backup_file_sha256",
    "copy_method",
    "overwrite_allowed",
    "source_replay_ok",
    "backup_replay_ok",
    "restore_replay_ok",
    "source_error_count",
    "backup_error_count",
    "restore_error_count",
    "status",
    "reason_codes",
    "created_at",
    "drill_sha256"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "ams.ams_codex.store_backup_drill.v0" },
    "store_backup_drill_id": { "type": "string", "minLength": 1 },
    "label": { "type": "string", "minLength": 1 },
    "source_store_path": { "type": "string", "minLength": 1 },
    "backup_snapshot_path": { "type": "string", "minLength": 1 },
    "restore_store_path": { "type": "string", "minLength": 1 },
    "source_state_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "backup_state_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "restore_state_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "backup_file_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "copy_method": { "type": "string", "const": "shutil.copy2+fsync" },
    "overwrite_allowed": { "type": "boolean" },
    "source_replay_ok": { "type": "boolean" },
    "backup_replay_ok": { "type": "boolean" },
    "restore_replay_ok": { "type": "boolean" },
    "source_error_count": { "type": "integer", "minimum": 0 },
    "backup_error_count": { "type": "integer", "minimum": 0 },
    "restore_error_count": { "type": "integer", "minimum": 0 },
    "status": { "type": "string", "enum": ["passed", "failed"] },
    "reason_codes": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "created_at": { "type": "string" },
    "drill_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
