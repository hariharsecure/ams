{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ams:ams:doc-action-patch-readback-receipt:v0",
  "title": "AMSDocActionPatchReadbackReceipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "doc_action_patch_readback_receipt_id",
    "label",
    "source_root",
    "doc_action_patch_preview_id",
    "doc_action_patch_preview_sha256",
    "doc_action_operator_approval_packet_id",
    "doc_action_operator_approval_packet_sha256",
    "doc_action_execution_plan_id",
    "doc_action_execution_plan_sha256",
    "source_doc_retirement_plan_id",
    "source_doc_retirement_plan_sha256",
    "readback",
    "required_readback_phrases",
    "required_gates",
    "receipt_verifies_readback_only",
    "approval_granted",
    "live_execution_allowed",
    "source_file_write_allowed",
    "source_file_move_allowed",
    "source_file_delete_allowed",
    "archive_create_allowed",
    "generated_surface_rewrite_allowed",
    "literal_patch_store_allowed",
    "preview_artifact_write_allowed",
    "provider_call_allowed",
    "network_call_allowed",
    "approval_actions",
    "execution_actions",
    "patch_actions",
    "live_boundaries",
    "status",
    "reason_codes",
    "created_at",
    "doc_action_patch_readback_receipt_sha256"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "ams.ams.doc_action_patch_readback_receipt.v0"
    },
    "doc_action_patch_readback_receipt_id": { "type": "string", "minLength": 1 },
    "label": { "type": "string", "minLength": 1 },
    "source_root": { "type": "string", "minLength": 1 },
    "doc_action_patch_preview_id": { "type": "string", "minLength": 1 },
    "doc_action_patch_preview_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "doc_action_operator_approval_packet_id": { "type": "string", "minLength": 1 },
    "doc_action_operator_approval_packet_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "doc_action_execution_plan_id": { "type": "string", "minLength": 1 },
    "doc_action_execution_plan_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "source_doc_retirement_plan_id": { "type": "string", "minLength": 1 },
    "source_doc_retirement_plan_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "readback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested_by",
        "readback_ref",
        "readback_present",
        "readback_text_sha256",
        "normalized_readback_sha256",
        "raw_readback_stored",
        "phrase_results",
        "required_phrases_present",
        "missing_required_phrases",
        "created_at"
      ],
      "properties": {
        "requested_by": { "type": "string", "minLength": 1 },
        "readback_ref": { "type": "string", "minLength": 1 },
        "readback_present": { "type": "boolean" },
        "readback_text_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "normalized_readback_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "raw_readback_stored": { "type": "boolean", "const": false },
        "phrase_results": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["phrase", "present", "evidence_sha256"],
            "properties": {
              "phrase": { "type": "string", "minLength": 1 },
              "present": { "type": "boolean" },
              "evidence_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
            }
          }
        },
        "required_phrases_present": { "type": "boolean" },
        "missing_required_phrases": { "type": "array", "items": { "type": "string" } },
        "created_at": { "type": "string", "minLength": 1 }
      }
    },
    "required_readback_phrases": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "uniqueItems": true
    },
    "required_gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "patch_preview_present",
        "patch_preview_ready_for_review",
        "patch_preview_hash_current",
        "patch_preview_grants_no_authority",
        "patch_summary_present",
        "patches_present",
        "readback_ref_present",
        "readback_present",
        "required_phrases_present",
        "raw_readback_not_stored",
        "receipt_grants_no_authority"
      ],
      "properties": {
        "patch_preview_present": { "type": "boolean" },
        "patch_preview_ready_for_review": { "type": "boolean" },
        "patch_preview_hash_current": { "type": "boolean" },
        "patch_preview_grants_no_authority": { "type": "boolean" },
        "patch_summary_present": { "type": "boolean" },
        "patches_present": { "type": "boolean" },
        "readback_ref_present": { "type": "boolean" },
        "readback_present": { "type": "boolean" },
        "required_phrases_present": { "type": "boolean" },
        "raw_readback_not_stored": { "type": "boolean" },
        "receipt_grants_no_authority": { "type": "boolean" }
      }
    },
    "receipt_verifies_readback_only": { "type": "boolean", "const": true },
    "approval_granted": { "type": "boolean", "const": false },
    "live_execution_allowed": { "type": "boolean", "const": false },
    "source_file_write_allowed": { "type": "boolean", "const": false },
    "source_file_move_allowed": { "type": "boolean", "const": false },
    "source_file_delete_allowed": { "type": "boolean", "const": false },
    "archive_create_allowed": { "type": "boolean", "const": false },
    "generated_surface_rewrite_allowed": { "type": "boolean", "const": false },
    "literal_patch_store_allowed": { "type": "boolean", "const": false },
    "preview_artifact_write_allowed": { "type": "boolean", "const": false },
    "provider_call_allowed": { "type": "boolean", "const": false },
    "network_call_allowed": { "type": "boolean", "const": false },
    "approval_actions": { "const": [] },
    "execution_actions": { "const": [] },
    "patch_actions": { "const": [] },
    "live_boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approval_granted",
        "source_file_rewritten",
        "source_file_deleted",
        "source_file_moved",
        "archive_created",
        "generated_surface_rewritten",
        "preview_artifact_written",
        "raw_patch_stored",
        "raw_source_markdown_stored",
        "raw_readback_stored",
        "discord_call_performed",
        "terminal_attach_performed",
        "terminal_capture_performed",
        "terminal_injection_performed",
        "persistent_process_started",
        "provider_call_performed",
        "network_call_performed",
        "secret_stored"
      ],
      "properties": {
        "approval_granted": { "type": "boolean", "const": false },
        "source_file_rewritten": { "type": "boolean", "const": false },
        "source_file_deleted": { "type": "boolean", "const": false },
        "source_file_moved": { "type": "boolean", "const": false },
        "archive_created": { "type": "boolean", "const": false },
        "generated_surface_rewritten": { "type": "boolean", "const": false },
        "preview_artifact_written": { "type": "boolean", "const": false },
        "raw_patch_stored": { "type": "boolean", "const": false },
        "raw_source_markdown_stored": { "type": "boolean", "const": false },
        "raw_readback_stored": { "type": "boolean", "const": false },
        "discord_call_performed": { "type": "boolean", "const": false },
        "terminal_attach_performed": { "type": "boolean", "const": false },
        "terminal_capture_performed": { "type": "boolean", "const": false },
        "terminal_injection_performed": { "type": "boolean", "const": false },
        "persistent_process_started": { "type": "boolean", "const": false },
        "provider_call_performed": { "type": "boolean", "const": false },
        "network_call_performed": { "type": "boolean", "const": false },
        "secret_stored": { "type": "boolean", "const": false }
      }
    },
    "status": { "type": "string", "enum": ["readback_verified", "blocked"] },
    "reason_codes": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "created_at": { "type": "string", "minLength": 1 },
    "doc_action_patch_readback_receipt_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
