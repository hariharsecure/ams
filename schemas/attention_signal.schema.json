{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ams:ams-codex:attention-signal:v0",
  "title": "AMSCodexAttentionSignal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "attention_signal_id",
    "attention_id",
    "parent_attention_id",
    "session_id",
    "context_id",
    "task_run_id",
    "source_surface",
    "source_kind",
    "source_ref",
    "source_event_id",
    "source_actor",
    "source_trust",
    "observed_at",
    "content_sha256",
    "content_length",
    "raw_content_stored",
    "classification_input_sha256",
    "importance",
    "urgency",
    "priority",
    "route_domain",
    "additional_domains",
    "route_status",
    "ack_required",
    "ack_status",
    "ack_due_at",
    "acked_at",
    "resolved_at",
    "requested_action",
    "reason_codes",
    "vector_memory",
    "created_at",
    "updated_at",
    "attention_signal_sha256"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "ams.ams_codex.attention_signal.v0" },
    "attention_signal_id": { "type": "string", "minLength": 1 },
    "attention_id": { "type": ["string", "null"] },
    "parent_attention_id": { "type": ["string", "null"] },
    "session_id": { "type": ["string", "null"] },
    "context_id": { "type": ["string", "null"] },
    "task_run_id": { "type": ["string", "null"] },
    "source_surface": { "type": "string", "minLength": 1 },
    "source_kind": { "type": "string", "minLength": 1 },
    "source_ref": { "type": "string", "minLength": 1 },
    "source_event_id": { "type": ["string", "null"] },
    "source_actor": { "type": ["string", "null"] },
    "source_trust": { "type": "string", "minLength": 1 },
    "observed_at": { "type": "string" },
    "content_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "content_length": { "type": "integer", "minimum": 0 },
    "raw_content_stored": { "type": "boolean", "const": false },
    "classification_input_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "importance": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
    "urgency": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
    "priority": { "type": "string", "enum": ["P0", "P1", "P2", "P3", "P4"] },
    "route_domain": {
      "type": "string",
      "enum": [
        "surface_discord",
        "surface_terminal",
        "training_ops",
        "cloud_ops",
        "ams_kernel",
        "provider_session",
        "security",
        "resource_capacity",
        "cyber_physical_ops",
        "animal_welfare",
        "research_memory",
        "unknown"
      ]
    },
    "additional_domains": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "route_status": { "type": "string", "enum": ["needs_ack", "routed"] },
    "ack_required": { "type": "boolean" },
    "ack_status": { "type": "string", "enum": ["new", "acknowledged", "routed", "deferred", "resolved"] },
    "ack_due_at": { "type": ["string", "null"] },
    "acked_at": { "type": ["string", "null"] },
    "resolved_at": { "type": ["string", "null"] },
    "requested_action": { "type": "string", "minLength": 1 },
    "reason_codes": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "vector_memory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "collection",
        "point_id",
        "chunk_ref",
        "embedding_status",
        "coverage",
        "metadata",
        "filter_keys"
      ],
      "properties": {
        "authority": { "type": "string", "const": "ams_store" },
        "collection": { "type": "string", "minLength": 1 },
        "point_id": { "type": "string", "minLength": 1 },
        "chunk_ref": { "type": "string", "minLength": 1 },
        "embedding_status": { "type": "string", "enum": ["not_embedded", "embedded", "skipped"] },
        "coverage": { "type": "string", "minLength": 1 },
        "metadata": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "attention_signal_id",
            "domain",
            "additional_domains",
            "priority",
            "session_id",
            "source_surface",
            "source_ref",
            "content_sha256",
            "created_at",
            "redaction"
          ],
          "properties": {
            "attention_signal_id": { "type": "string", "minLength": 1 },
            "domain": { "type": "string", "minLength": 1 },
            "additional_domains": { "type": "array", "items": { "type": "string" } },
            "priority": { "type": "string", "minLength": 1 },
            "session_id": { "type": ["string", "null"] },
            "source_surface": { "type": "string", "minLength": 1 },
            "source_ref": { "type": "string", "minLength": 1 },
            "content_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
            "created_at": { "type": "string" },
            "redaction": { "type": "string", "minLength": 1 }
          }
        },
        "filter_keys": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      }
    },
    "created_at": { "type": "string" },
    "updated_at": { "type": "string" },
    "attention_signal_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
