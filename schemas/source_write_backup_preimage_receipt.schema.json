    "backup_artifact",
    "backup_summary",
    "rollback_ref",
    "post_write_replay_requirements",
    "required_gates",
    "backup_preimage_captured",
    "apply_allowed",
    "live_execution_allowed",
    "source_file_write_allowed",
    "source_file_move_allowed",
    "source_file_delete_allowed",
    "source_backup_write_allowed",
    "archive_create_allowed",
    "generated_surface_rewrite_allowed",
    "provider_call_allowed",
    "network_call_allowed",
    "backup_actions",
    "source_write_actions",
    "rollback_actions",
    "post_write_replay_actions",
    "live_boundaries",
    "status",
    "reason_codes",
    "created_at",
    "source_write_backup_preimage_receipt_sha256"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "ams.ams.source_write_backup_preimage_receipt.v0"
    },
    "source_write_backup_preimage_receipt_id": { "type": "string", "minLength": 1 },
    "label": { "type": "string", "minLength": 1 },
    "source_root": { "type": "string", "minLength": 1 },
    "backup_root": { "type": "string", "minLength": 1 },
    "backup_dir": { "type": "string", "minLength": 1 },
    "source_write_executor_preflight_id": { "type": "string", "minLength": 1 },
    "source_write_executor_preflight_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "doc_action_patch_apply_acceptance_packet_id": { "type": "string", "minLength": 1 },
    "doc_action_patch_apply_acceptance_packet_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "source_path": { "type": "string" },
    "preflight_source_ref": { "type": "object" },
    "captured_source_ref": { "type": "object" },
    "source_hash_matches_preflight": { "type": "boolean" },
    "backup_preimage_policy": { "type": "object" },
    "backup_artifact": {
      "type": "object",
      "required": [
        "source_path",
        "backup_path",
        "backup_path_under_source_root",
        "backup_path_under_backup_root",
        "backup_exists",
        "backup_sha256",
        "backup_size_bytes",
        "source_preimage_sha256",
        "source_preimage_size_bytes",
        "backup_hash_matches_source_preimage",
        "backup_artifact_written",
        "raw_source_stored_in_ams_state",
        "raw_patch_stored_in_ams_state",
        "raw_executor_output_stored_in_ams_state",
        "source_file_rewritten",
        "source_file_deleted",
        "source_file_moved",
        "rollback_executed",
        "archive_created",
        "generated_surface_rewritten"
      ],
      "properties": {
        "source_path": { "type": "string" },
        "backup_path": { "type": "string" },
        "backup_path_under_source_root": { "type": "boolean" },
        "backup_path_under_backup_root": { "type": "boolean" },
        "backup_exists": { "type": "boolean" },
        "backup_sha256": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" },
        "backup_size_bytes": { "type": "integer", "minimum": 0 },
        "source_preimage_sha256": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" },
        "source_preimage_size_bytes": { "type": ["integer", "null"], "minimum": 0 },
        "backup_hash_matches_source_preimage": { "type": "boolean" },
        "backup_artifact_written": { "type": "boolean" },
        "raw_source_stored_in_ams_state": { "type": "boolean", "const": false },
        "raw_patch_stored_in_ams_state": { "type": "boolean", "const": false },
        "raw_executor_output_stored_in_ams_state": { "type": "boolean", "const": false },
        "source_file_rewritten": { "type": "boolean", "const": false },
        "source_file_deleted": { "type": "boolean", "const": false },
        "source_file_moved": { "type": "boolean", "const": false },
        "rollback_executed": { "type": "boolean", "const": false },
        "archive_created": { "type": "boolean", "const": false },
        "generated_surface_rewritten": { "type": "boolean", "const": false }
      }
    },
    "backup_summary": { "type": "object" },
    "rollback_ref": { "type": "object" },
    "post_write_replay_requirements": { "type": "object" },
    "required_gates": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "backup_preimage_captured": { "type": "boolean" },
    "apply_allowed": { "type": "boolean", "const": false },
    "live_execution_allowed": { "type": "boolean", "const": false },
    "source_file_write_allowed": { "type": "boolean", "const": false },
    "source_file_move_allowed": { "type": "boolean", "const": false },
    "source_file_delete_allowed": { "type": "boolean", "const": false },
    "source_backup_write_allowed": { "type": "boolean" },
    "archive_create_allowed": { "type": "boolean", "const": false },
    "generated_surface_rewrite_allowed": { "type": "boolean", "const": false },
    "provider_call_allowed": { "type": "boolean", "const": false },
    "network_call_allowed": { "type": "boolean", "const": false },
    "backup_actions": { "type": "array" },
    "source_write_actions": { "type": "array", "maxItems": 0 },
    "rollback_actions": { "type": "array", "maxItems": 0 },
    "post_write_replay_actions": { "type": "array", "maxItems": 0 },
    "live_boundaries": {
      "type": "object",
      "required": [
        "source_backup_written",
        "backup_artifact_written",
        "source_file_rewritten",
        "source_file_deleted",
        "source_file_moved",
        "rollback_executed",
        "archive_created",
        "generated_surface_rewritten",
        "raw_source_stored_in_ams_state",
        "raw_patch_stored_in_ams_state",
        "raw_executor_output_stored_in_ams_state",
        "discord_call_performed",
        "terminal_attach_performed",
        "terminal_capture_performed",
        "terminal_injection_performed",
        "persistent_process_started",
        "provider_call_performed",
        "network_call_performed",
        "secret_stored"
      ],
      "properties": {
        "source_backup_written": { "type": "boolean" },
        "backup_artifact_written": { "type": "boolean" },
        "source_file_rewritten": { "type": "boolean", "const": false },
        "source_file_deleted": { "type": "boolean", "const": false },
        "source_file_moved": { "type": "boolean", "const": false },
        "rollback_executed": { "type": "boolean", "const": false },
        "archive_created": { "type": "boolean", "const": false },
        "generated_surface_rewritten": { "type": "boolean", "const": false },
        "raw_source_stored_in_ams_state": { "type": "boolean", "const": false },
        "raw_patch_stored_in_ams_state": { "type": "boolean", "const": false },
        "raw_executor_output_stored_in_ams_state": { "type": "boolean", "const": false },
        "discord_call_performed": { "type": "boolean", "const": false },
        "terminal_attach_performed": { "type": "boolean", "const": false },
        "terminal_capture_performed": { "type": "boolean", "const": false },
        "terminal_injection_performed": { "type": "boolean", "const": false },
        "persistent_process_started": { "type": "boolean", "const": false },
        "provider_call_performed": { "type": "boolean", "const": false },
        "network_call_performed": { "type": "boolean", "const": false },
        "secret_stored": { "type": "boolean", "const": false }
      }
    },
    "status": {
      "type": "string",
      "enum": ["backup_preimage_captured", "blocked"]
    },
    "reason_codes": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "created_at": { "type": "string", "minLength": 1 },
    "source_write_backup_preimage_receipt_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
