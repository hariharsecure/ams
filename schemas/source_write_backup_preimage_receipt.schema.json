{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ams:ams:source-write-backup-preimage-receipt:v0",
  "title": "AMSSourceWriteBackupPreimageReceipt",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "source_write_backup_preimage_receipt_id",
    "label",
    "source_root",
    "backup_root",
    "backup_dir",
    "source_write_executor_preflight_id",
    "source_write_executor_preflight_sha256",
    "doc_action_patch_apply_acceptance_packet_id",
    "doc_action_patch_apply_acceptance_packet_sha256",
    "source_path",
    "preflight_source_ref",
    "captured_source_ref",
    "source_hash_matches_preflight",
