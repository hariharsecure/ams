{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ams:ams:surface-definition:v0",
  "title": "AMSSurfaceDefinition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "definition_id",
    "provider",
    "surface",
    "version",
    "mode",
    "allowed_methods",
    "capabilities",
    "risk_flags",
    "requires_signed_policy",
    "requires_readback",
    "definition",
    "definition_sha256",
    "status",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "ams.ams.surface_definition.v0" },
    "definition_id": { "type": "string", "minLength": 1 },
    "provider": { "type": "string", "minLength": 1 },
    "surface": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "mode": { "type": "string", "enum": ["dry_run", "shadow", "live"] },
    "endpoint": { "type": ["string", "null"] },
    "allowed_methods": { "type": "array", "items": { "type": "string" } },
    "capabilities": { "type": "array", "items": { "type": "string" } },
    "risk_flags": { "type": "array", "items": { "type": "string" } },
    "requires_signed_policy": { "type": "boolean" },
    "requires_readback": { "type": "boolean" },
    "signed_policy_sha256": {
      "type": ["string", "null"],
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "definition": { "type": "object" },
    "definition_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "status": { "type": "string", "enum": ["active", "deprecated", "disabled"] },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
