{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ams:ams:doc-action-operator-approval-packet:v0",
  "title": "AMSDocActionOperatorApprovalPacket",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "doc_action_operator_approval_packet_id",
    "label",
    "source_root",
    "doc_action_execution_plan_id",
    "doc_action_execution_plan_sha256",
    "source_doc_retirement_plan_id",
    "source_doc_retirement_plan_sha256",
    "plan_summary",
    "approval_request",
    "required_gates",
    "approval_granted",
    "live_execution_allowed",
    "file_rewrite_allowed",
    "file_move_allowed",
    "file_delete_allowed",
    "archive_create_allowed",
    "generated_surface_rewrite_allowed",
    "approval_actions",
    "execution_actions",
    "live_boundaries",
    "status",
    "reason_codes",
    "created_at",
    "doc_action_operator_approval_packet_sha256"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "ams.ams.doc_action_operator_approval_packet.v0" },
    "doc_action_operator_approval_packet_id": { "type": "string", "minLength": 1 },
    "label": { "type": "string", "minLength": 1 },
    "source_root": { "type": "string", "minLength": 1 },
    "doc_action_execution_plan_id": { "type": "string", "minLength": 1 },
    "doc_action_execution_plan_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "source_doc_retirement_plan_id": { "type": "string", "minLength": 1 },
    "source_doc_retirement_plan_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "plan_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selected_action_count",
        "skipped_action_count",
        "selected_paths",
        "selected_action_set_sha256",
        "preview_hashes_sha256",
        "source_hashes_sha256",
        "source_hashes_captured",
        "preview_hashes_present",
        "plan_status",
        "plan_live_execution_allowed",
        "plan_operator_approval_granted",
        "raw_content_stored"
      ],
      "properties": {
        "selected_action_count": { "type": "integer", "minimum": 0 },
        "skipped_action_count": { "type": "integer", "minimum": 0 },
        "selected_paths": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "selected_action_set_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "preview_hashes_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "source_hashes_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "source_hashes_captured": { "type": "boolean" },
        "preview_hashes_present": { "type": "boolean" },
        "plan_status": { "type": "string", "enum": ["allow", "defer", "deny"] },
        "plan_live_execution_allowed": { "type": "boolean", "const": false },
        "plan_operator_approval_granted": { "type": "boolean", "const": false },
        "raw_content_stored": { "type": "boolean", "const": false }
      }
    },
    "approval_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_review_steps",
        "required_readback_phrases",
        "operator_readback_captured",
        "raw_readback_stored",
        "approval_granted_by_readback"
      ],
      "properties": {
        "required_review_steps": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "required_readback_phrases": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "operator_readback_captured": { "type": "boolean", "const": false },
        "raw_readback_stored": { "type": "boolean", "const": false },
        "approval_granted_by_readback": { "type": "boolean", "const": false }
      }
    },
    "required_gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_plan_present",
        "execution_plan_hash_present",
        "source_doc_retirement_plan_ref_present",
        "source_doc_retirement_plan_hash_present",
        "selected_actions_present",
        "source_hashes_captured",
        "preview_hashes_present",
        "execution_plan_preview_only",
        "execution_plan_write_disabled",
        "execution_plan_delete_move_disabled",
        "execution_plan_operator_approval_not_granted",
        "execution_plan_live_execution_not_allowed",
        "raw_content_not_stored"
      ],
      "properties": {
        "execution_plan_present": { "type": "boolean" },
        "execution_plan_hash_present": { "type": "boolean" },
        "source_doc_retirement_plan_ref_present": { "type": "boolean" },
        "source_doc_retirement_plan_hash_present": { "type": "boolean" },
        "selected_actions_present": { "type": "boolean" },
        "source_hashes_captured": { "type": "boolean" },
        "preview_hashes_present": { "type": "boolean" },
        "execution_plan_preview_only": { "type": "boolean" },
        "execution_plan_write_disabled": { "type": "boolean" },
        "execution_plan_delete_move_disabled": { "type": "boolean" },
        "execution_plan_operator_approval_not_granted": { "type": "boolean" },
        "execution_plan_live_execution_not_allowed": { "type": "boolean" },
        "raw_content_not_stored": { "type": "boolean" }
      }
    },
    "approval_granted": { "type": "boolean", "const": false },
    "live_execution_allowed": { "type": "boolean", "const": false },
    "file_rewrite_allowed": { "type": "boolean", "const": false },
    "file_move_allowed": { "type": "boolean", "const": false },
    "file_delete_allowed": { "type": "boolean", "const": false },
    "archive_create_allowed": { "type": "boolean", "const": false },
    "generated_surface_rewrite_allowed": { "type": "boolean", "const": false },
    "approval_actions": { "type": "array", "const": [] },
    "execution_actions": { "type": "array", "const": [] },
    "live_boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approval_granted",
        "file_rewritten",
        "file_deleted",
        "file_moved",
        "archive_created",
        "generated_surface_rewritten",
        "discord_call_performed",
        "terminal_attach_performed",
        "terminal_capture_performed",
        "terminal_injection_performed",
        "persistent_process_started",
        "provider_call_performed",
        "network_call_performed",
        "raw_readback_stored",
        "raw_markdown_stored",
        "secret_stored"
      ],
      "properties": {
        "approval_granted": { "type": "boolean", "const": false },
        "file_rewritten": { "type": "boolean", "const": false },
        "file_deleted": { "type": "boolean", "const": false },
        "file_moved": { "type": "boolean", "const": false },
        "archive_created": { "type": "boolean", "const": false },
        "generated_surface_rewritten": { "type": "boolean", "const": false },
        "discord_call_performed": { "type": "boolean", "const": false },
        "terminal_attach_performed": { "type": "boolean", "const": false },
        "terminal_capture_performed": { "type": "boolean", "const": false },
        "terminal_injection_performed": { "type": "boolean", "const": false },
        "persistent_process_started": { "type": "boolean", "const": false },
        "provider_call_performed": { "type": "boolean", "const": false },
        "network_call_performed": { "type": "boolean", "const": false },
        "raw_readback_stored": { "type": "boolean", "const": false },
        "raw_markdown_stored": { "type": "boolean", "const": false },
        "secret_stored": { "type": "boolean", "const": false }
      }
    },
    "status": { "type": "string", "enum": ["ready_for_operator_review", "blocked"] },
    "reason_codes": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "created_at": { "type": "string", "minLength": 1 },
    "doc_action_operator_approval_packet_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
