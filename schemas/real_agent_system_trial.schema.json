{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ams:ams:real-agent-system-trial:v0",
  "title": "AMSRealAgentSystemTrial",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "real_agent_system_trial_id",
    "label",
    "mode",
    "execution_mode",
    "source_root",
    "runtime_root",
    "artifact_root",
    "operator_persona",
    "agents",
    "arms",
    "scenario_count",
    "invocation_count",
    "attention_signal_ids",
    "scenario_matrix",
    "invocations",
    "metrics",
    "artifact_refs",
    "live_boundaries",
    "egress_actions",
    "limitations",
    "status",
    "reason_codes",
    "created_at",
    "updated_at",
    "real_agent_system_trial_sha256"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "ams.ams.real_agent_system_trial.v0" },
    "real_agent_system_trial_id": { "type": "string", "minLength": 1 },
    "label": { "type": "string", "minLength": 1 },
    "mode": { "type": "string", "const": "no_discord_real_agent_system_trial" },
    "execution_mode": { "type": "string", "enum": ["stubbed_runner", "real_cli"] },
    "source_root": { "type": "string", "minLength": 1 },
    "runtime_root": { "type": "string", "minLength": 1 },
    "artifact_root": { "type": "string", "minLength": 1 },
    "operator_persona": { "type": "object", "additionalProperties": true },
    "agents": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["agent_name", "provider", "command_available", "command_path_sha256", "command_version", "real_cli_allowed"],
        "properties": {
          "agent_name": { "type": "string", "minLength": 1 },
          "provider": { "type": "string", "minLength": 1 },
          "command_available": { "type": "boolean" },
          "command_path_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "command_version": { "type": "string" },
          "real_cli_allowed": { "type": "boolean" }
        }
      }
    },
    "arms": {
      "type": "array",
      "minItems": 2,
      "items": { "type": "string", "enum": ["raw_compacted", "ams_backed"] }
    },
    "scenario_count": { "type": "integer", "minimum": 1 },
    "invocation_count": { "type": "integer", "minimum": 1 },
    "attention_signal_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "scenario_matrix": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": true } },
    "invocations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "invocation_id",
          "agent_name",
          "provider",
          "scenario_id",
          "arm",
          "argv",
          "cwd",
          "env_names",
          "command_available",
          "command_version",
          "prompt_sha256",
          "prompt_ref",
          "raw_prompt_stored_in_ams_state",
          "stdout_ref",
          "stdout_sha256",
          "stderr_ref",
          "stderr_sha256",
          "raw_output_stored_in_ams_state",
          "returncode",
          "timed_out",
          "elapsed_ms",
          "started_at",
          "ended_at",
          "artifact_refs",
          "parse_ok",
          "scores",
          "score_summary"
        ],
        "properties": {
          "invocation_id": { "type": "string", "minLength": 1 },
          "agent_name": { "type": "string", "minLength": 1 },
          "provider": { "type": "string", "minLength": 1 },
          "scenario_id": { "type": "string", "minLength": 1 },
          "arm": { "type": "string", "enum": ["raw_compacted", "ams_backed"] },
          "argv": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "cwd": { "type": "string", "minLength": 1 },
          "env_names": { "type": "array", "items": { "type": "string" } },
          "command_available": { "type": "boolean" },
          "command_version": { "type": "string" },
          "prompt_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "prompt_ref": { "type": "string", "minLength": 1 },
          "raw_prompt_stored_in_ams_state": { "type": "boolean", "const": false },
          "stdout_ref": { "type": "string", "minLength": 1 },
          "stdout_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "stderr_ref": { "type": "string", "minLength": 1 },
          "stderr_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "raw_output_stored_in_ams_state": { "type": "boolean", "const": false },
          "returncode": { "type": ["integer", "null"] },
          "timed_out": { "type": "boolean" },
          "elapsed_ms": { "type": "integer", "minimum": 0 },
          "started_at": { "type": "string" },
          "ended_at": { "type": "string" },
          "artifact_refs": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": true } },
          "parse_ok": { "type": "boolean" },
          "scores": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
          "score_summary": { "type": "object", "additionalProperties": true }
        }
      }
    },
    "metrics": { "type": "object", "additionalProperties": true },
    "artifact_refs": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": true } },
    "live_boundaries": { "type": "object", "additionalProperties": true },
    "egress_actions": { "type": "array" },
    "limitations": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "status": { "type": "string", "enum": ["allow", "defer", "deny"] },
    "reason_codes": { "type": "array", "items": { "type": "string" } },
    "created_at": { "type": "string" },
    "updated_at": { "type": "string" },
    "real_agent_system_trial_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
