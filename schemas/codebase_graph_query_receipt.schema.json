{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ams:ams:codebase-graph-query-receipt:v0",
  "title": "AMSCodebaseGraphQueryReceipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "codebase_graph_query_receipt_id",
    "label",
    "source_root",
    "snapshot_id",
    "snapshot_sha256",
    "query_kind",
    "query",
    "result",
    "graph_fresh",
    "status",
    "reason_codes",
    "raw_source_stored",
    "created_at",
    "codebase_graph_query_receipt_sha256"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "ams.ams.codebase_graph_query_receipt.v0" },
    "codebase_graph_query_receipt_id": { "type": "string", "minLength": 1 },
    "label": { "type": "string", "minLength": 1 },
    "source_root": { "type": "string", "minLength": 1 },
    "snapshot_id": { "type": "string", "minLength": 1 },
    "snapshot_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "query_kind": { "type": "string", "enum": ["impact_slice", "related_tests", "stale_graph_check"] },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paths", "depth", "rejected_paths"],
      "properties": {
        "paths": { "type": "array", "items": { "type": "string" } },
        "depth": { "type": "integer", "minimum": 0, "maximum": 8 },
        "rejected_paths": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "reason"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "reason": { "type": "string", "enum": ["unsafe_path"] }
            }
          }
        }
      }
    },
    "result": { "type": "object", "additionalProperties": true },
    "graph_fresh": { "type": "boolean" },
    "status": { "type": "string", "enum": ["allow", "defer", "deny"] },
    "reason_codes": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "raw_source_stored": { "type": "boolean", "const": false },
    "created_at": { "type": "string", "minLength": 1 },
    "codebase_graph_query_receipt_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
