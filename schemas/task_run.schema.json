{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ams:ams:task-run:v0",
  "title": "AMSTaskRun",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_run_id",
    "session_id",
    "context_id",
    "attention_id",
    "attempt",
    "idempotency_key",
    "actor",
    "requested_by",
    "provider",
    "action",
    "state",
    "cwd",
    "sandbox",
    "input_context_sha256",
    "compaction_epoch",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "ams.ams.task_run.v0" },
    "task_run_id": { "type": "string", "minLength": 1 },
    "session_id": { "type": "string", "minLength": 1 },
    "ams_task_id": { "type": ["string", "null"] },
    "context_id": { "type": "string", "minLength": 1 },
    "attention_id": { "type": "string", "minLength": 1 },
    "event_id": { "type": ["string", "null"] },
    "parent_run_id": { "type": ["string", "null"] },
    "attempt": { "type": "integer", "minimum": 1 },
    "retry_of": { "type": ["string", "null"] },
    "idempotency_key": { "type": "string", "minLength": 1 },
    "actor": { "type": "string", "minLength": 1 },
    "requested_by": { "type": "string", "minLength": 1 },
    "lease_id": { "type": ["string", "null"] },
    "lease_holder": { "type": ["string", "null"] },
    "lease_expires_at": { "type": ["string", "null"], "format": "date-time" },
    "lease_revision": { "type": ["integer", "null"], "minimum": 0 },
    "provider": { "type": "string", "minLength": 1 },
    "provider_surface": { "type": ["string", "null"] },
    "provider_session_id": { "type": ["string", "null"] },
    "provider_agent_id": { "type": ["string", "null"] },
    "provider_request_id": { "type": ["string", "null"] },
    "provider_turn_id": { "type": ["string", "null"] },
    "method": { "type": "string", "minLength": 1 },
    "action": { "type": "string", "minLength": 1 },
    "state": {
      "type": "string",
      "enum": ["planned", "dispatching", "in_flight", "dispatched", "landed", "blocked", "failed", "verified", "completed"]
    },
    "cwd": { "type": "string", "minLength": 1 },
    "sandbox": { "type": "string", "minLength": 1 },
    "model": { "type": ["string", "null"] },
    "tool_scope": { "type": "array", "items": { "type": "string" } },
    "allowed_tools": { "type": "array", "items": { "type": "string" } },
    "tool_definition_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "definition_id", "definition_sha256"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "definition_id": { "type": "string", "minLength": 1 },
          "definition_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
        }
      }
    },
    "surface_definition_ref": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["provider", "surface", "version", "definition_id", "definition_sha256"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "surface": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "definition_id": { "type": "string", "minLength": 1 },
        "definition_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "definition_snapshot_sha256": {
      "type": ["string", "null"],
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "pre_dispatch_gate_id": { "type": ["string", "null"] },
    "tool_gate_ids": { "type": "array", "items": { "type": "string" } },
    "pre_egress_gate_id": { "type": ["string", "null"] },
    "gate_mode": { "type": "string", "enum": ["shadow_only", "dry_run", "enforced"] },
    "shadow_only": { "type": "boolean" },
    "no_repeat_keys_checked": { "type": "array", "items": { "type": "string" } },
    "no_repeat_verdict": { "type": "string", "minLength": 1 },
    "capability_snapshot_sha256": {
      "type": ["string", "null"],
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "input_context_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "summary_checkpoint_id": { "type": ["string", "null"] },
    "compaction_epoch": { "type": "integer", "minimum": 0 },
    "source_refs": { "type": "array", "items": { "type": "string" } },
    "artifact_refs": { "type": "array", "items": { "type": "string" } },
    "receipts": { "type": "array", "items": { "type": "string" } },
    "outcome": { "type": ["string", "null"] },
    "error_class": { "type": ["string", "null"] },
    "exit_status": { "type": ["integer", "null"] },
    "stdout_sha256": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" },
    "stderr_sha256": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" },
    "final_checkpoint_id": { "type": ["string", "null"] },
    "input_tokens": { "type": "integer", "minimum": 0 },
    "output_tokens": { "type": "integer", "minimum": 0 },
    "total_tokens": { "type": "integer", "minimum": 0 },
    "remaining_context_estimate": { "type": ["integer", "null"], "minimum": 0 },
    "duration_ms": { "type": ["integer", "null"], "minimum": 0 },
    "gate_wait_ms": { "type": ["integer", "null"], "minimum": 0 },
    "outbox_id": { "type": ["string", "null"] },
    "delivery_status": {
      "type": "string",
      "enum": ["not_requested", "queued", "sent", "readback_verified", "deferred", "failed", "ambiguous"]
    },
    "readback_ref": { "type": ["string", "null"] },
    "readback_sha256": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" },
    "started_at": { "type": ["string", "null"], "format": "date-time" },
    "completed_at": { "type": ["string", "null"], "format": "date-time" },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
