{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ams:ams:downloaded-artifact-quarantine:v0",
  "title": "AMSDownloadedArtifactQuarantine",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "downloaded_artifact_quarantine_id",
    "source_uri",
    "source_type",
    "declared_media_type",
    "declared_sha256",
    "size_bytes",
    "download_status",
    "quarantine_status",
    "network_fetch_allowed",
    "raw_content_stored",
    "local_path",
    "reviewed_by",
    "reviewed_at",
    "reason_codes",
    "created_at",
    "updated_at",
    "quarantine_sha256"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "ams.ams.downloaded_artifact_quarantine.v0" },
    "downloaded_artifact_quarantine_id": { "type": "string", "minLength": 1 },
    "source_uri": { "type": "string", "minLength": 1 },
    "source_type": { "type": "string", "enum": ["url", "file", "dataset", "unknown"] },
    "declared_media_type": { "type": ["string", "null"] },
    "declared_sha256": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" },
    "size_bytes": { "type": ["integer", "null"], "minimum": 0 },
    "download_status": { "type": "string", "enum": ["not_downloaded", "downloaded_external"] },
    "quarantine_status": { "type": "string", "enum": ["quarantined", "approved_for_index", "rejected"] },
    "network_fetch_allowed": { "type": "boolean", "const": false },
    "raw_content_stored": { "type": "boolean", "const": false },
    "local_path": { "type": ["string", "null"] },
    "reviewed_by": { "type": ["string", "null"] },
    "reviewed_at": { "type": ["string", "null"] },
    "reason_codes": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "created_at": { "type": "string" },
    "updated_at": { "type": "string" },
    "quarantine_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
