{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ams:ams:discord-source-packet:v0",
  "title": "AMSDiscordSourcePacket",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "discord_source_packet_id",
    "source_surface",
    "source_kind",
    "source_ref",
    "channel_id",
    "message_id",
    "thread_id",
    "root_message_id",
    "reply_to_message_id",
    "source_event_id",
    "source_actor",
    "observed_at",
    "ingest_mode",
    "read_only",
    "gateway_started",
    "send_allowed",
    "bulk_history_allowed",
    "token_stored",
    "raw_content_stored",
    "content_sha256",
    "content_length",
    "summary",
    "summary_sha256",
    "attachment_refs",
    "attachment_count",
    "forbidden_secret_key_count",
    "forbidden_send_key_count",
    "input_shape_sha256",
    "attention_signal_created",
    "attention_signal_id",
    "attention_signal_sha256",
    "status",
    "reason_codes",
    "created_at",
    "source_packet_sha256"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "ams.ams.discord_source_packet.v0" },
    "discord_source_packet_id": { "type": "string", "minLength": 1 },
    "source_surface": { "type": "string", "const": "discord" },
    "source_kind": { "type": "string", "minLength": 1 },
    "source_ref": { "type": "string", "pattern": "^discord://[^/]+/.+" },
    "channel_id": { "type": "string", "minLength": 1 },
    "message_id": { "type": "string", "minLength": 1 },
    "thread_id": { "type": ["string", "null"] },
    "root_message_id": { "type": ["string", "null"] },
    "reply_to_message_id": { "type": ["string", "null"] },
    "source_event_id": { "type": "string", "minLength": 1 },
    "source_actor": { "type": ["string", "null"] },
    "observed_at": { "type": "string" },
    "ingest_mode": { "type": "string", "const": "source_packet" },
    "read_only": { "type": "boolean", "const": true },
    "gateway_started": { "type": "boolean", "const": false },
    "send_allowed": { "type": "boolean", "const": false },
    "bulk_history_allowed": { "type": "boolean", "const": false },
    "token_stored": { "type": "boolean", "const": false },
    "raw_content_stored": { "type": "boolean", "const": false },
    "content_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "content_length": { "type": "integer", "minimum": 0 },
    "summary": { "type": "string" },
    "summary_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "attachment_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref", "media_type", "size", "sha256"],
        "properties": {
          "ref": { "type": "string", "minLength": 1 },
          "media_type": { "type": ["string", "null"] },
          "size": { "type": "integer", "minimum": 0 },
          "sha256": { "type": ["string", "null"] }
        }
      }
    },
    "attachment_count": { "type": "integer", "minimum": 0 },
    "forbidden_secret_key_count": { "type": "integer", "minimum": 0 },
    "forbidden_send_key_count": { "type": "integer", "minimum": 0 },
    "input_shape_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "attention_signal_created": { "type": "boolean" },
    "attention_signal_id": { "type": ["string", "null"] },
    "attention_signal_sha256": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" },
    "status": { "type": "string", "enum": ["ready_for_attention", "blocked"] },
    "reason_codes": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "source_packet_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
