{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ams:ams-codex:real-agent-trial:v0",
  "title": "AMSCodexRealAgentTrial",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "real_agent_trial_id",
    "approval_id",
    "mode",
    "runtime_root",
    "attention_signal_ids",
    "invocations",
    "metrics",
    "process_start_allowed",
    "egress_actions",
    "created_at",
    "updated_at",
    "trial_sha256"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "ams.ams_codex.real_agent_trial.v0" },
    "real_agent_trial_id": { "type": "string", "minLength": 1 },
    "approval_id": { "type": "string", "minLength": 1 },
    "mode": { "type": "string", "const": "real_provider_smoke" },
    "runtime_root": { "type": "string", "minLength": 1 },
    "artifact_root": { "type": "string", "minLength": 1 },
    "attention_signal_ids": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "invocations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "invocation_id",
          "agent_name",
          "provider",
          "arm",
          "argv",
          "cwd",
          "env_names",
          "prompt_sha256",
          "stdout_ref",
          "stdout_sha256",
          "stderr_ref",
          "stderr_sha256",
          "prompt_ref",
          "returncode",
          "timed_out",
          "elapsed_ms",
          "started_at",
          "ended_at",
          "parsed_response",
          "scores"
        ],
        "properties": {
          "invocation_id": { "type": "string", "minLength": 1 },
          "agent_name": { "type": "string", "minLength": 1 },
          "provider": { "type": "string", "minLength": 1 },
          "arm": { "type": "string", "enum": ["raw_compacted", "ams_backed"] },
          "argv": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "cwd": { "type": "string", "minLength": 1 },
          "env_names": { "type": "array", "items": { "type": "string" } },
          "prompt_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "stdout_ref": { "type": "string", "minLength": 1 },
          "stdout_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "stderr_ref": { "type": "string", "minLength": 1 },
          "stderr_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "prompt_ref": { "type": "string", "minLength": 1 },
          "returncode": { "type": ["integer", "null"] },
          "timed_out": { "type": "boolean" },
          "elapsed_ms": { "type": "integer", "minimum": 0 },
          "started_at": { "type": "string" },
          "ended_at": { "type": "string" },
          "parsed_response": { "type": "object" },
          "scores": { "type": "array", "items": { "type": "object" } }
        }
      }
    },
    "metrics": { "type": "object", "additionalProperties": true },
    "process_start_allowed": { "type": "boolean" },
    "egress_actions": { "type": "array" },
    "created_at": { "type": "string" },
    "updated_at": { "type": "string" },
    "trial_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
