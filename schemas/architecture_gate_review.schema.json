{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ams:ams:architecture-gate-review:v0",
  "title": "AMSArchitectureGateReview",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "architecture_gate_review_id",
    "subject_kind",
    "subject_id",
    "architecture_audit_id",
    "architecture_audit_sha256",
    "paths",
    "scoped_paths",
    "required",
    "decision",
    "reason_codes",
    "created_at",
    "gate_sha256"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "ams.ams.architecture_gate_review.v0" },
    "architecture_gate_review_id": { "type": "string", "minLength": 1 },
    "subject_kind": { "type": "string", "minLength": 1 },
    "subject_id": { "type": "string", "minLength": 1 },
    "architecture_audit_id": { "type": ["string", "null"] },
    "architecture_audit_sha256": {
      "type": ["string", "null"],
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "paths": { "type": "array", "items": { "type": "string" } },
    "scoped_paths": { "type": "array", "items": { "type": "string" } },
    "required": { "type": "boolean" },
    "decision": { "type": "string", "enum": ["allow", "defer", "deny"] },
    "reason_codes": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "created_at": { "type": "string" },
    "gate_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
