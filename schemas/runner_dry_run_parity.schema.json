{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ams:ams:runner-dry-run-parity:v0",
  "title": "AMSRunnerDryRunParity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "runner_dry_run_parity_id",
    "dispatch_envelope",
    "dispatch_envelope_id",
    "dispatch_envelope_sha256",
    "task_run_id",
    "session_id",
    "provider",
    "surface",
    "runner_mode",
    "shadow_launch_plan_id",
    "shadow_launch_plan_sha256",
    "package_manifest",
    "package_manifest_summary",
    "package_manifest_sha256",
    "package_verification",
    "package_verification_sha256",
    "runner_preflight",
    "runner_preflight_sha256",
    "definition_snapshot_sha256",
    "tool_definition_refs",
    "surface_definition_ref",
    "parity_checks",
    "process_start_allowed",
    "network_egress_allowed",
    "start_actions",
    "status",
    "reason_codes",
    "created_at",
    "parity_sha256"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "ams.ams.runner_dry_run_parity.v0" },
    "runner_dry_run_parity_id": { "type": "string", "minLength": 1 },
    "dispatch_envelope": { "type": "object" },
    "dispatch_envelope_id": { "type": "string", "minLength": 1 },
    "dispatch_envelope_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "task_run_id": { "type": "string", "minLength": 1 },
    "session_id": { "type": "string", "minLength": 1 },
    "provider": { "type": "string", "minLength": 1 },
    "surface": { "type": "string", "minLength": 1 },
    "runner_mode": { "type": "string", "enum": ["live_shadow_preflight", "dry_run"] },
    "shadow_launch_plan_id": { "type": ["string", "null"] },
    "shadow_launch_plan_sha256": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" },
    "package_manifest": { "type": "object" },
    "package_manifest_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package_manifest_id", "name", "version", "package_mode"],
      "properties": {
        "package_manifest_id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "package_mode": { "type": "string", "enum": ["shadow_only", "dry_run", "enforced"] }
      }
    },
    "package_manifest_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "package_verification": { "type": "object" },
    "package_verification_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "runner_preflight": { "type": "object" },
    "runner_preflight_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "definition_snapshot_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "tool_definition_refs": { "type": "array", "items": { "type": "object" } },
    "surface_definition_ref": { "type": "object" },
    "parity_checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_verified",
        "package_manifest_hash_match",
        "package_manifest_valid",
        "registry_matches_manifest",
        "envelope_definitions_in_manifest",
        "definition_snapshot_match",
        "runner_preflight_allowed",
        "runner_preflight_live_shadow",
        "runner_preflight_inert",
        "runner_invocation_matches_envelope",
        "process_start_allowed_false",
        "network_egress_allowed_false"
      ],
      "properties": {
        "package_verified": { "type": "boolean" },
        "package_manifest_hash_match": { "type": "boolean" },
        "package_manifest_valid": { "type": "boolean" },
        "registry_matches_manifest": { "type": "boolean" },
        "envelope_definitions_in_manifest": { "type": "boolean" },
        "definition_snapshot_match": { "type": "boolean" },
        "runner_preflight_allowed": { "type": "boolean" },
        "runner_preflight_live_shadow": { "type": "boolean" },
        "runner_preflight_inert": { "type": "boolean" },
        "runner_invocation_matches_envelope": { "type": "boolean" },
        "process_start_allowed_false": { "type": "boolean", "const": true },
        "network_egress_allowed_false": { "type": "boolean", "const": true }
      }
    },
    "process_start_allowed": { "type": "boolean", "const": false },
    "network_egress_allowed": { "type": "boolean", "const": false },
    "start_actions": { "type": "array", "maxItems": 0 },
    "status": { "type": "string", "enum": ["ready_for_operator_review", "blocked"] },
    "reason_codes": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "created_at": { "type": "string" },
    "parity_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
